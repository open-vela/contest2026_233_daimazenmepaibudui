	bool "Offline mock (development only)"
	help
		Fixed local response for host tests. Not valid for the contest demo.

endchoice

config AI_LLM_API_KEY
	string "Legacy test API key"
	default ""
	depends on HELLO_APP_LLM_MOCK

config AI_LLM_MODEL
	string "LLM model name"
	default "mimo-v2.5"

