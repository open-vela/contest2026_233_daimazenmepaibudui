#
# 智爱陪伴 - SF32LB52-DevKit-LCD AI Companion Config
# Based on sf32lb52_devkit_lcd nsh config with AI Agent enabled
#

# ---- Architecture & Chip ----
CONFIG_ARCH="arm"
CONFIG_ARCH_ARM=y
CONFIG_ARCH_ARMV8M=y
CONFIG_ARCH_CORTEXM33=y
CONFIG_ARCH_FPU=y
CONFIG_ARCH_BOARD_CUSTOM=y
CONFIG_ARCH_BOARD_CUSTOM_DIR="../vendor/sifli/boards/sf32lb52/sf32lb52_devkit_lcd"
CONFIG_ARCH_BOARD_CUSTOM_DIR_RELPATH=y
CONFIG_ARCH_BOARD_CUSTOM_NAME="sf32lb52_ai"
CONFIG_ARCH_CHIP_ARM_CUSTOM=y
CONFIG_ARCH_CHIP_CUSTOM=y
CONFIG_ARCH_CHIP_CUSTOM_DIR="../vendor/sifli/chips/sf32lb52"
CONFIG_ARCH_CHIP_CUSTOM_DIR_RELPATH=y
CONFIG_ARCH_CHIP_CUSTOM_NAME="sf32lb52"
CONFIG_ARCH_CHIP_DEBUG_H=y
CONFIG_ARCH_CHIP_SF32LB52=y
CONFIG_ARCH_SETJMP_H=y
CONFIG_ARCH_STDARG_H=y
CONFIG_ARMV8M_SYSTICK=y

# ---- Board Init ----
CONFIG_BOARD_EARLY_INITIALIZE=y
CONFIG_BOARD_LATE_INITIALIZE=y
CONFIG_BOARD_LOOPSPERMSEC=8499

# ---- BSP Peripherals ----
CONFIG_ADC=y
CONFIG_ANALOG=y
CONFIG_BSP_ENABLE_MPI1=y
CONFIG_BSP_ENABLE_MPI2=y
CONFIG_BSP_MPI1_MODE_3=y
CONFIG_BSP_QSPI2_MEM_SIZE=16
CONFIG_BSP_UART1_RX_USING_DMA=y
CONFIG_BSP_UART2_RX_USING_DMA=y
CONFIG_BSP_USING_BTIM1=y
CONFIG_BSP_USING_I2C1=y
CONFIG_BSP_USING_I2C2=y
CONFIG_BSP_USING_I2C=y
CONFIG_BSP_USING_LCDC=y
CONFIG_BSP_USING_PWM2=y
CONFIG_BSP_USING_PWM=y
CONFIG_BSP_USING_SPI1=y
CONFIG_BSP_USING_SPI=y
CONFIG_BSP_USING_TIM=y
CONFIG_BSP_USING_UART1=y
CONFIG_BSP_USING_UART2=y

# ---- Bluetooth (disabled due to zblue stack issues) ----
# CONFIG_BT is not set
# CONFIG_DRIVERS_BLUETOOTH is not set

# ---- Display (AMOLED) ----
CONFIG_LCD=y
CONFIG_LCD_DEV=y
CONFIG_LCD_FRAMEBUFFER=y
CONFIG_LCD_MAXPOWER=100
CONFIG_LCD_USING_CO5300=y
CONFIG_SIFLI_LCD=y
CONFIG_VIDEO_FB=y
CONFIG_DRIVERS_VIDEO=y

# ---- Touch Screen ----
CONFIG_INPUT=y
CONFIG_INPUT_FT6146=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCH_IRQ_PIN=31

# ---- LVGL Graphics ----
CONFIG_GRAPHICS_LVGL=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_USE_NUTTX=y
CONFIG_LV_USE_NUTTX_LCD=y
CONFIG_LV_USE_NUTTX_TOUCHSCREEN=y

# ---- Audio (for voice companion) ----
CONFIG_AUDIO=y
CONFIG_DRIVERS_AUDIO=y

# ---- GPIO ----
CONFIG_DEV_GPIO=y
CONFIG_INPUT_BUTTONS=y

# ---- Storage ----
CONFIG_FS_FAT=y
CONFIG_FS_LITTLEFS=y
CONFIG_FS_LITTLEFS_PROGRAM_SIZE_FACTOR=1
CONFIG_FS_LOCK_BUCKET_SIZE=4
CONFIG_FS_PROCFS=y
CONFIG_FS_ROMFS=y
CONFIG_FS_TMPFS=y
CONFIG_MMCSD=y
CONFIG_MTD=y
CONFIG_MTD_BYTE_WRITE=y
CONFIG_UNQLITE=y

# ---- Memory ----
CONFIG_MM_REGIONS=2
CONFIG_DEFAULT_TASK_STACKSIZE=16096
CONFIG_IDLETHREAD_STACKSIZE=16096
CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE=32768

# ---- Scheduler ----
CONFIG_SCHED_BACKTRACE=y
CONFIG_SCHED_EVENTS=y
CONFIG_SCHED_HPWORK=y
CONFIG_SCHED_LPWORK=y
CONFIG_SCHED_WAITPID=y
CONFIG_RR_INTERVAL=10

# ---- Networking (BLE proxy for cloud LLM) ----
CONFIG_NET=y
CONFIG_NET_SOCKOPTS=y
CONFIG_NET_TCP=y
CONFIG_NET_UDP=y
CONFIG_NET_ROUTE=y
CONFIG_NETDEV_IFINDEX=y
CONFIG_NETDB=y
CONFIG_NETDB_DNSCLIENT=y
CONFIG_LIBC_EXECFUNCS=y
CONFIG_LIBC_NETDB=y
CONFIG_CRYPTO=y
CONFIG_TLS=y
CONFIG_NETUTILS_CJSON=y
CONFIG_CRYPTO_MBEDTLS=y

# ---- USB RNDIS (Ethernet-over-USB gadget) ----
CONFIG_RNDIS=y

# ---- System ----
CONFIG_ALLOW_BSD_COMPONENTS=y
CONFIG_ALLSYMS=y
CONFIG_BUILTIN=y
CONFIG_CANCELLATION_POINTS=y
CONFIG_DEV_URANDOM=y
CONFIG_DRIVERS_WIRELESS=y
CONFIG_ELF=y
CONFIG_ETC_ROMFS=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_NSH_FILEIOSIZE=512
CONFIG_NSH_LINELEN=64
CONFIG_NSH_READLINE=y
CONFIG_PIPES=y
CONFIG_PTHREAD_MUTEX_TYPES=y
CONFIG_RAW_BINARY=y
CONFIG_RTC=y
CONFIG_RTC_ALARM=y
CONFIG_RTC_ARCH=y
CONFIG_RTC_DATETIME=y
CONFIG_RTC_DRIVER=y
CONFIG_SENSORS=y
CONFIG_SIG_EVTHREAD=y
CONFIG_SPI=y
CONFIG_SPI_DRIVER=y
CONFIG_TIMER=y
CONFIG_TIMER_ARCH=y
CONFIG_TLS_NCLEANUP=4
CONFIG_TLS_NELEM=4
CONFIG_TLS_TASK_NELEM=4
CONFIG_WATCHDOG=y
CONFIG_I2C_BITBANG=y
CONFIG_I2C_SLAVE=y
CONFIG_SF32LB52_USBDEV=y

# ---- Debug ----
CONFIG_DEBUG_ASSERTIONS=y
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_SCHED=y
CONFIG_DEBUG_SYMBOLS=y
CONFIG_FRAME_POINTER=y
CONFIG_SYSLOG_COLOR_OUTPUT=y
CONFIG_SYSTEM_DUMPSTACK=y

# ---- NSH Shell ----
CONFIG_SYSTEM_NSH=y
CONFIG_SYSTEM_SYSTEM=y
CONFIG_SYSTEM_POPEN=y
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_SYSTEM_I2CTOOL=y

# ---- UART ----
CONFIG_UART_BAUD=1000000
CONFIG_UART_BUFSZ=1024
CONFIG_UART_SERIAL_CONSOLE=y

# ==== AI Agent (智爱陪伴核心) ====
CONFIG_EXAMPLES_AI_AGENT_VELA=y
CONFIG_EXAMPLES_AI_AGENT_VELA_PROGNAME="ai_agent"
CONFIG_EXAMPLES_AI_AGENT_VELA_PRIORITY=100
CONFIG_EXAMPLES_AI_AGENT_VELA_STACKSIZE=32768
CONFIG_EXAMPLES_AI_AGENT_VELA_DATA_DIR="/data/ai_agent"
CONFIG_EXAMPLES_AI_AGENT_VELA_NODE_ID="zhi_ai_001"
CONFIG_EXAMPLES_AI_AGENT_VELA_NODE_DISPLAY_NAME="智爱陪伴"
CONFIG_EXAMPLES_AI_AGENT_VELA_SHELL_FULL=y
CONFIG_AI_AGENT_LVGL_UI=n
CONFIG_AI_AGENT_MQTT=y
CONFIG_AI_AGENT_MCP=y
CONFIG_AI_AGENT_NODE=n
CONFIG_AI_AGENT_FEISHU=n
CONFIG_AI_AGENT_WEIXIN=n
CONFIG_AI_AGENT_BLE_GATT=n
CONFIG_AI_AGENT_BLE_NET=n
CONFIG_AI_AGENT_TLS_CONN_POOL_SIZE=2

# ==== 智爱陪伴自定义应用 ====
CONFIG_LVX_USE_CONTEST2026_233_ZHI_AI=y
CONFIG_LVX_USE_CONTEST2026_233_HELLO_APP=y
CONFIG_I2C=y
CONFIG_EXAMPLES_AUDIO_TEST=y

# robot_ui 使用的 LVGL 字体(需在编译期启用)
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# robot_ui HTTP/MQTT 推送需要域名解析(DNS client over UDP)
CONFIG_NET_UDP=y
CONFIG_NETDB_DNSCLIENT=y
CONFIG_SYSLOG_BUFFER=y
# ==== USB 网络（RNDIS + Windows ICS 共享上网）====
# 这些是工作区 .config 里手工配过、但 defconfig 一直漏掉的关键项，
# 补上之后 defconfig 才是完整可复现的配置源（否则重新 configure 会丢网络功能）
CONFIG_DEBUG_USB=y
CONFIG_DEBUG_USB_ERROR=y
CONFIG_DEBUG_USB_WARN=y
CONFIG_DEBUG_USB_INFO=y
CONFIG_RNDIS_EPINTIN=5
CONFIG_NET_ETH_PKTSIZE=1514
CONFIG_NET_ICMP_SOCKET=y
CONFIG_NETDB_DNSSERVER_IPv4ADDR=0xc0a88901
CONFIG_NETINIT_IPADDR=0xc0a88902
CONFIG_NETINIT_DRIPADDR=0xc0a88901
CONFIG_NETUTILS_PING=y
CONFIG_AI_LLM_MODEL="gpt-3.5-turbo"
