CONFIG_DEBUG_SCHED=y
CONFIG_DEBUG_SYMBOLS=y
# NOTE: frame pointers are OFF on purpose.
# With -O2 (CONFIG_DEBUG_CUSTOMOPT), -fno-omit-frame-pointer reserves r7,
# and mbedtls' hand-written Thumb-2 asm in bignum_core.c hard-fails with
#     error: r7 cannot be used in 'asm' here
# Dropping frame pointers frees r7 and also saves a register for the
# compiler. CONFIG_DEBUG_SYMBOLS (-g3) is still on, so addr2line/backtrace
# via DWARF still works; only the frame-pointer chain walking is lost.
# CONFIG_FRAME_POINTER is not set
CONFIG_SYSLOG_COLOR_OUTPUT=y
CONFIG_SYSTEM_DUMPSTACK=y
# IMPORTANT: keep optimization ON even though debug symbols are enabled.
# nuttx/Kconfig has this as a *choice*:
#     default DEBUG_NOOPT  if DEBUG_SYMBOLS
#     default DEBUG_FULLOPT if !DEBUG_SYMBOLS
# so simply turning on CONFIG_DEBUG_SYMBOLS silently builds the whole
# firmware with -O0, which made LVGL's software renderer ~100x slower
# (~800 CPU cycles per pixel, UI stuck at 12 loops/second) and the touch
# feel terrible. Keep symbols (readable backtraces) AND optimize.
# CONFIG_DEBUG_NOOPT is not set
CONFIG_DEBUG_CUSTOMOPT=y
CONFIG_DEBUG_OPTLEVEL="-O2"

