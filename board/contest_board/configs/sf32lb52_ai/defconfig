# ==== IOB（网络包缓冲池）====
# IOB_BUFSIZE=196 是 RNDIS+SACK+IPv6 这条组合的**最小值**，于是
# 1514 字节的满尺寸 TCP 段要 8 个 IOB 链起来；TLS 握手一轮要 ClientHello
# + ServerHello + 证书（常见 4~8 KB）→ 十几个 IOB 同时在飞。
# 而 Kconfig 默认值是 24（!NET_WRITE_BUFFERS && NET_READAHEAD 的分支），
# 只够 3 个满段，RNDIS 驱动那边 iob_tryalloc(false) 是**非阻塞**的、池空
# 直接失败。2026-10-23 真机取证：ASR 4/4 卡在
# ssl_handshake ret=-0x004e（NET_SEND_FAILED，TCP connect 已成功、
# ClientHello 发不出去）—— 就是网卡 IOB 队列被吃满那一类瞬时失败。
# 24 -> 64：池子 4.7 KB -> 12.5 KB，足够握手 + 在飞段；代价约 +9 KB
# 常驻（对一块能一口气 malloc 485 KB ASR 请求体的板子可以忽略）。
# 顺带 NCHAINS 一起抬：它按 Kconfig 默认跟 NBUFFERS 走，链头不够一样堵。
#
# 2026-10-24 二次取证（同一症状回来了，但这次不是 IOB 顶到）：
# 收到 TLS 记录最大 16 KB ≈ 85 个 IOB，64 个装不下一条完整记录。
# 64 -> 256：池子 12.5 KB -> 53 KB，够 1 条满记录 + 在飞 TX + MQTT/ARP
# 并发；SRAM 堆从 ~166 KB 掉到 ~123 KB，大块（485 KB ASR 体）走 PSRAM，
# 不受影响。
CONFIG_IOB_NBUFFERS=256
CONFIG_IOB_NCHAINS=256

# ==== devif 回调槽（socket callback 池）====
# ★★★ 这才是「一开始能聊、后来不能了」的真凶 ★★★
# 全系统共用一个固定池，Kconfig 自己写死了："this will be the maximum
# number of callbacks available to the system at all times"。
#   MEMPOOL_DEFINE(g_cbprealloc, blksize, PREALLOC=16, maxalloc=0, dynalloc=0)
#     dynalloc=0 -> expandsize = 0*blksize + HEADER < blksize+HEADER
#                 -> 不允许向堆扩展
#     mempool_zallocate(&g_cbprealloc, 0) 的 timeout=0 -> 也不阻塞
#   => 第 17 个回调请求必然返回 NULL。
# 而 NuttX 的 send() 路径（CONFIG_NET_TCP_WRITE_BUFFERS 未开，走
# net/tcp/tcp_send_unbuffered.c:584）里：
#     ret = -ENOMEM; /* Assume allocation failure */
#     state.snd_cb = tcp_callback_alloc(conn);   // -> devif_callback_alloc
#   回调拿不到就带着 -ENOMEM 返回 -> send() errno=12
#   -> mbedTLS MBEDTLS_ERR_NET_SEND_FAILED (-0x004e)
#   -> "[vela_tls] ssl_handshake ret=-0x004e errno=12" -> ASR/LLM/TTS 全挂。
# 每条 TCP 连接至少吃 1 个（connect/recv/send/close 各申请一次），本机
# 同时在跑 MQTT + LCDMIRROR + ASR/LLM/TTS 三条 HTTPS，再叠加 close 后
# 连接在 TIME_WAIT/收尾阶段仍占着 conn->clscb
# （CONFIG_NET_TCP_WAIT_TIMEOUT=120 秒），16 个很快就漏光/占光。
# 16 -> 64：并发上限抬 4 倍（BSS 代价约 +1.3 KB）。
# 再把动态分配打开（0 -> 4）：池子真用完时按批从堆补，而不是硬失败。
# 这是保险绳 —— 就算还有别的地方漏回调，系统也只是变慢，不会失声。
CONFIG_NET_PREALLOC_DEVIF_CALLBACKS=64
CONFIG_NET_ALLOC_DEVIF_CALLBACKS=4
CONFIG_NET_ICMP_SOCKET=y
CONFIG_NETDB_DNSSERVER_IPv4ADDR=0xdf050505
CONFIG_NETINIT_IPADDR=0xc0a88902
CONFIG_NETINIT_DRIPADDR=0xc0a88901
