# ==== 智爱陪伴自定义应用 ====
CONFIG_LVX_USE_CONTEST2026_233_ZHI_AI=y
CONFIG_LVX_USE_CONTEST2026_233_HELLO_APP=y
# hello_app stack. The original 16384 was too small because ai_companion_main
# reserved a 32KB frame in its prologue:
#     sub.w sp, sp, #32000
# The real culprit was a 16000-sample (32KB) local test buffer that GCC hoisted
# into the prologue; it is only used by --sound-self-test. That buffer is now
# "static" (see app/hello_app/ai_companion_main.c), which brings the entry frame
# down to 88 bytes:
#     sub sp, #88
# 32KB is kept as a comfortable margin for the deeper call chains (the LLM/JSON
# paths still use 4KB-class locals), instead of the 64KB that was only needed
# to work around the 32KB entry frame.
CONFIG_HELLO_APP_STACKSIZE=32768
# Stack coloration: makes "ps" report each thread's stack high-water mark, which
# is how we verify that a stack size is actually sufficient instead of guessing.
# Cheap; can be turned off for the final release build if desired.
CONFIG_STACK_COLORATION=y
# LPWORK carries the USB RNDIS send/receive work. The UI task (robot_ui) was
# raised to 110, which sits right on top of the worker threads at 100 and can
# starve the RNDIS data path. Put the low-priority work queue above the app
# threads so USB/network work always wins; hpwork (224, used by the touch
# driver) is still higher than both.
CONFIG_SCHED_LPWORKPRIORITY=120
CONFIG_I2C=y
CONFIG_EXAMPLES_AUDIO_TEST=y
# Hardware self-test (display/touch/buttons/GPIO/I2C enumeration + read-only checks)
# NSH command: hw_test
# NOTE: no Kconfig symbol here on purpose. nuttx_generate_kconfig() bails out as
# soon as <build>/apps/Kconfig exists, so a *new* app directory never gets picked
# up by the auto-generated Kconfig and its symbol stays permanently "not set".
# hw_test therefore hangs off the team-wide switch instead, same as robot_ui,
# and app/hw_test/CMakeLists.txt guards on CONFIG_LVX_USE_CONTEST2026_233_ZHI_AI.

# ==== Xiaomi MiMo agent (packages/demos/mimo) ====
# MiMo is the official openvela demo from Xiaomi Corporation.
# OpenAI-compatible endpoint: https://api.xiaomimimo.com/v1/chat/completions
# Model: mimo-v2-flash
# Depends on CONFIG_NETUTILS_CJSON, CONFIG_NETUTILS_WEBCLIENT, CONFIG_CRYPTO_MBEDTLS.
# CJSON and MBEDTLS are already enabled on this board; WEBCLIENT is auto-selected.
# NSH usage: mimo "hello"   (run `mimo` with no args for interactive mode)
CONFIG_DEMOS_MIMO=y
CONFIG_MIMO_MODEL="mimo-v2.5"
# Token Plan endpoint (contest-provided free plan). A "tp-" key MUST use this
# host; an "sk-" pay-as-you-go key uses https://api.xiaomimimo.com/v1 instead.
# Both take the same OpenAI-compatible body; model mimo-v2.5.
CONFIG_MIMO_API_BASE_URL="https://token-plan-cn.xiaomimimo.com/v1/chat/completions"
# NOTE: the API key is intentionally NOT committed here. Put it in the local
# build config instead (cmake_out/<build>/.config):
# CONFIG_MIMO_API_KEY="sk-xxxx"
# or get one from https://platform.xiaomimimo.com/
# CONFIG_MIMO_API_KEY is not set
# WARNING: keep these comment lines ASCII-only. CMake's file(STRINGS) drops
# non-ASCII bytes, and a CJK comment can collapse into a whitespace-only
# fragment, which crashes nuttx_kconfig.cmake ("REGEX MATCH needs at least
# 5 arguments"). That is why this block has no Chinese.

