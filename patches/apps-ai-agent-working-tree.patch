+/* ── gzip → 明文 ──────────────────────────────────────────────────────
+ * puff 只吃 raw DEFLATE，所以要自己剥掉 gzip 头（10 字节起，带 FEXTRA /
+ * FNAME / FCOMMENT / FHCRC 时会更长）和末尾 8 字节的 CRC32+ISIZE。
+ * 成功把明文长度写进 *dst_len。 */
+static int gunzip_into(const unsigned char *src, size_t src_len,
+                       unsigned char *dst, size_t *dst_len)
+{
+    size_t pos = 10;
+    size_t xlen;
+    unsigned long dlen;
+    unsigned long slen;
+    int flg;
+
+    if (src_len < 18 || src[0] != 0x1f || src[1] != 0x8b || src[2] != 8) {
+        return ERROR;
+    }
+    flg = src[3];
+
+    if (flg & 0x04) {                       /* FEXTRA：2 字节长度 + 那么长 */
+        if (pos + 2 > src_len) {
+            return ERROR;
+        }
+        xlen = (size_t)src[pos] | ((size_t)src[pos + 1] << 8);
+        pos += 2;
+        if (pos + xlen > src_len) {
+            return ERROR;
+        }
+        pos += xlen;
+    }
+    if (flg & 0x08) {                       /* FNAME：到 0 为止 */
+        while (pos < src_len && src[pos]) {
+            pos++;
+        }
+        pos++;
+    }
+    if (flg & 0x10) {                       /* FCOMMENT：到 0 为止 */
+        while (pos < src_len && src[pos]) {
+            pos++;
+        }
+        pos++;
+    }
+    if (flg & 0x02) {                       /* FHCRC */
+        pos += 2;
+    }
+    /* 末尾 8 字节是 CRC32 + ISIZE，不算在 DEFLATE 流里。 */
+    if (pos + 8 > src_len) {
+        return ERROR;
+    }
+
+    dlen = *dst_len;
+    slen = (unsigned long)(src_len - 8 - pos);
+    if (puff(dst, &dlen, src + pos, &slen) != 0) {
+        return ERROR;
+    }
+    *dst_len = (size_t)dlen;
+    return OK;
+}
+
+/* body 是 gzip 就解，不是就原样拷 —— 哪天服务端不压缩了也不用改代码。
+ * 明文末尾补 NUL（cJSON 要），真实长度走 out_len。 */
+static int body_decompress(const char *src, size_t src_len,
+                           char *dst, size_t dst_cap, size_t *out_len)
+{
+    if (src_len >= 2 && (unsigned char)src[0] == 0x1f &&
+        (unsigned char)src[1] == 0x8b) {
+        size_t dlen = dst_cap;
+
+        if (gunzip_into((const unsigned char *)src, src_len,
+                        (unsigned char *)dst, &dlen) != OK) {
+            return ERROR;
+        }
+        *out_len = dlen;
+    } else {
+        if (src_len >= dst_cap) {
+            return ERROR;
+        }
+        memcpy(dst, src, src_len);
+        *out_len = src_len;
+    }
+
+    if (*out_len >= dst_cap) {
+        return ERROR;
+    }
+    dst[*out_len] = '\0';
+    return OK;
+}
