+static void soul_heal_legacy_english_rule(void)
+{
+    static const char *legacy = "中文优先，用户用英文则用英文回复";
+    static const char *fixed =
+        "全程简体中文：用户说英文/拼音也用中文回答；时间日期用中文口语"
+        "（「现在是晚上十点十五分」），不用 3:30 PM / 22:15 这类格式";
+    char body[2048];
+    FILE *f;
+    size_t n;
+    char *hit;
+
+    f = fopen(AGENT_SOUL_FILE, "r");
+    if (!f) {
+        return;
+    }
+    n = fread(body, 1, sizeof(body) - 1, f);
+    fclose(f);
+    body[n] = '\0';
+
+    hit = strstr(body, legacy);
+    if (hit == NULL) {
+        return;  /* 没有旧句：要么是新版默认值，要么用户自己写过，都不动 */
+    }
