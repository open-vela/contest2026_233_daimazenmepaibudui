+/* ──────────────────────────────────────────────────────────────
+ * Backend 0: Open-Meteo —— ★ 2026-10-27 ★ 两个接口都**不要 key**
+ *
+ *   ① 地理编码  GET https://geocoding-api.open-meteo.com/v1/search
+ *                ?name=<城市>&count=1&language=zh&format=json
+ *                → { "results":[{ "latitude","longitude","name","admin1","country" }] }
+ *   ② 天气      GET https://api.open-meteo.com/v1/forecast
+ *                ?latitude=..&longitude=..
+ *                &current=temperature_2m,relative_humidity_2m,apparent_temperature,
+ *                         weather_code,wind_speed_10m
+ *                &daily=temperature_2m_max,temperature_2m_min,
+ *                       precipitation_probability_max
+ *                &timezone=auto&forecast_days=1
+ *                → { "current":{...}, "daily":{ "…":[…] } }
+ *
+ * ★ 为什么把它排在 Tavily/SerpAPI **前面**：
+ *   原来的 get_weather 根本不是天气接口 —— 只是拼个「<城市> weather today」
+ *   去搜网页（那段还在，退成兜底）。于是**没配搜索 key 就连天气也查不了**。
+ *   老人问「今天多少度」不该取决于一把搜索 key。Open-Meteo 免费、免注册、
+ *   免 key、专做天气，答案也比「搜出来的摘要」准。
+ * ★ 输出**纯口语中文**，跟 tool_get_time 同一个纪律：AI 拿到就能直接念。
+ * ★ 依赖：只用现成的 https_get_json / url_encode / cJSON，不新增依赖。
+ * ──────────────────────────────────────────────────────────────*/
+
+/* ★ 8KB 是量出来的：地理编码 count=8 最大回包实测 2223 字节（「朝阳」这种
+ * 全国重名最多的词），4KB 贴边、再长点的地名就悬。临时 calloc，加得起。
+ * 同一类坑上一条注释里刚栽过（新浪 16KB 装 42KB），别省这 4KB。 */
+#define WEATHER_BUF_SIZE (8 * 1024)
+
+/* WMO 4677 天气代码 → 能张口念出来的中文。
+ * 只列到「老人能听懂」的程度，不细分到毛毛雨/冻毛毛雨那种。 */
+static const char *wmo_to_cn(int code)
+{
+    switch (code) {
+    case 0:  return "晴";
+    case 1:  return "晴";
+    case 2:  return "多云";
+    case 3:  return "阴天";
+    case 45: case 48: return "有雾";
+    case 51: case 53: case 55: case 56: case 57: return "下毛毛雨";
+    case 61: return "下小雨";
+    case 63: return "下中雨";
+    case 65: case 66: case 67: return "下大雨";
+    case 71: return "下小雪";
+    case 73: return "下中雪";
+    case 75: case 77: return "下大雪";
+    case 80: return "下阵雨";
+    case 81: case 82: return "下大雨";
+    case 85: case 86: return "下阵雪";
+    case 95: return "下雷阵雨";
+    case 96: case 99: return "下雷阵雨，还有冰雹";
+    default: return "天儿有点说不上来";
+    }
+}
+
+/* ── 地名解析：一条**截尾重试链** ──────────────────────────────────
+ *
+ * 老人问天气说的是「济南历城区今天天气怎么样」，但 Open-Meteo 的地理编码
+ * **不认识区县**（实测 济南历城区 / 济南历城 / 济南历 三条全是 0 条），
+ * 只认到「济南」。旧代码一次查不到就直接退到搜索兜底 → 用户听到的是
+ * 「没查到「济南历城区」的天气」，而答案其实就在隔壁。
+ *
+ * 两条实测规则，都对着真接口跑过（2026-10-27）：
+ *   ① **逐字截尾**：查不到就去掉最后一个 UTF-8 字再查，最多 5 次。
+ *      济南历城区→济南历城→济南历→**济南** ✓   广州天河区→…→**广州** ✓
+ *      北京朝阳区→…→**北京** ✓
+ *   ② **只认有人住的地方**（feature_code 以 PPL 开头），机场/河流/山往后排。
+ *      没有这条，「上海浦东」会查到**浦东机场**（AIRP），「上海浦东新区」
+ *      截到「上海浦东」也落到机场。加了这条就继续往下截到「上海」。
+ *
+ *   顺带把 count 从 1 提到 8，按 feature_code 排序挑「最大那个」：
+ *   PPLC(首都) < PPLA(省会) < PPLA2(地级) < PPLA3 < PPLA4 < PPL(普通)。
+ *   「北京」有 3 条，PPLC 那条（北京）排第一，不会挑到重庆那个北京村。
+ *
+ * ⚠️ 诚实说清这条链的边界：**重名没法解**。「朝阳区」截到「朝阳」后全国
+ *   有 5 个叫朝阳的地方，链子只会挑 admin 级别最高的，答的可能是山西的。
+ *   好在回复里**带上了地名**（「朝阳（山西）现在 …」），老人一听就知道
+ *   对不上，会再说一遍。要真解得开得上行政区划数据库，不在这一轮。
+ *
+ * ⚠️ 误杀只慢一点、放行错了才会答错 —— 所以宁可多截几次，也不硬猜。
+ * ──────────────────────────────────────────────────────────────*/
+
+/* feature_code 排序：数字越小越大/越主要。认不出的排最后。 */
+static int geo_feature_rank(const char *fc)
+{
+    if (!fc || !fc[0])            return 8;
+    if (strcmp(fc, "PPLC") == 0)  return 0;   /* 首都 */
+    if (strcmp(fc, "PPLA") == 0)  return 1;   /* 省会 */
+    if (strcmp(fc, "PPLA2") == 0) return 2;   /* 地级市 */
+    if (strcmp(fc, "PPLA3") == 0) return 3;
+    if (strcmp(fc, "PPLA4") == 0) return 4;
+    if (strncmp(fc, "PPL", 3) == 0) return 5; /* 普通居民点 */
+    return 8;                                  /* 机场/河/山等，能不选就不选 */
+}
+
+/* 去掉最后一个 UTF-8 字（汉字 3 字节、ASCII 1 字节）。
+ * 别用 strspn/strlen-1：后者会砍掉半个汉字，前者会把 EF 打头的汉字整个吃掉。 */
+static void geo_drop_last(char *s)
+{
+    size_t n = strlen(s);
+    size_t i = n;
+
+    if (n == 0) {
+        return;
+    }
+    i = n - 1;
+    while (i > 0 && ((unsigned char)s[i] & 0xC0) == 0x80) {
+        i--;
+    }
+    s[i] = '\0';
+}
+
+/* 取前 n 个 UTF-8 字。截到字边界，装不下就停，**绝不切半个汉字**。 */
+static void geo_take_head(const char *src, char *dst, size_t cap, int n)
+{
+    size_t off = 0;
+    int    taken = 0;
+
+    if (cap == 0) {
+        return;
+    }
+    dst[0] = '\0';
+    while (*src && taken < n) {
+        unsigned char c = (unsigned char)*src;
+        int clen = (c < 0x80) ? 1 :
+                   ((c & 0xE0) == 0xC0) ? 2 :
+                   ((c & 0xF0) == 0xE0) ? 3 :
+                   ((c & 0xF8) == 0xF0) ? 4 : 1;
+
+        if (off + (size_t)clen + 1 > cap) {
+            break;
+        }
+        memcpy(dst + off, src, (size_t)clen);
+        off += (size_t)clen;
+        src += clen;
+        taken++;
+    }
+    dst[off] = '\0';
+}
+
+/* 这个名字开头是汉字吗？是的话才允许「跳到前两个字」。
+ * 英文名走这条会截成 "Ne"，那就是瞎猜，宁可老老实实逐字截尾。 */
+static int geo_starts_cjk(const char *s)
+{
+    return (unsigned char)s[0] >= 0x80;
+}
+
+/* ── 地理编码结果缓存（4 条，够覆盖「北京 上海 广州 济南」）────────────
+ *
+ * 为什么必须缓存：**这个网络一次 HTTPS 往返就要 ~5 秒**（同一轮里 TTS 单个
+ * POST 实测 3.2~13.9 秒，LLM 一轮 5~11 秒，都是同一个数量级）。截尾链
+ * 串行走 3~4 个往返，实测「天气快路」识别后 24138 ms 才拿到回复 —— **比
+ * 直接问大模型（5018~11476 ms）还慢**，快路反而成了慢路。
+ *
+ * 同一个城市老人会反复问，第二次就该是 0 个往返。缓存在内存里，
+ * 断电就没了 —— 这是对的，天气本来就是几分钟一变的东西。 */
+typedef struct {
+    /* key / disp 都得装下调用方那份 char location[256]。写 64/80 会被
+     * -Wformat-truncation 抓到，而且是**真**截断 —— key 被砍会让两个不同
+     * 的长名字撞成同一条缓存，disp 被砍会让 TTS 念半截地名。
+     * 4 条 × (288+288+16) ≈ 2.4KB 静态，SRAM 还够。 */
+    char   key[288];       /* 用户原话，直接整串比 */
+    double lat, lon;
+    char   disp[288];      /* 解析出来的地名（口语用） */
+    int    used;
+} geo_cache_ent_t;
+
+static geo_cache_ent_t s_geo_cache[4];
+
+static int geo_cache_get(const char *key,
+                         double *lat, double *lon,
+                         char *disp, size_t disp_cap)
+{
+    int i;
+
+    for (i = 0; i < (int)(sizeof(s_geo_cache) / sizeof(s_geo_cache[0])); i++) {
+        geo_cache_ent_t *e = &s_geo_cache[i];
+
+        if (e->used && strcmp(e->key, key) == 0) {
+            *lat = e->lat;
+            *lon = e->lon;
+            snprintf(disp, disp_cap, "%s", e->disp);
+            return OK;
+        }
+    }
+    return ERROR;
+}
+
+static void geo_cache_put(const char *key, double lat, double lon,
+                          const char *disp)
+{
+    static int next;                       /* 轮着覆盖最老的那条 */
+    geo_cache_ent_t *e = &s_geo_cache[next];
+
+    next = (next + 1) % (int)(sizeof(s_geo_cache) / sizeof(s_geo_cache[0]));
+    snprintf(e->key, sizeof(e->key), "%s", key);
+    snprintf(e->disp, sizeof(e->disp), "%s", disp);
+    e->lat  = lat;
+    e->lon  = lon;
+    e->used = 1;
+}
+
+/* 单次查询：查 `name`，在 PPL* 里挑 feature_code 最大的那个。
+ * 找到返回 OK 并填 lat/lon/disp；没找到返回 ERROR，**不碰输出**。 */
+static int geocode_one(const char *name,
+                       double *lat, double *lon,
+                       char *disp, size_t disp_cap)
+{
+    char   enc[768];
+    char   path[1024];
+    char  *buf;
+    int    status;
+    int    ret = ERROR;
+    cJSON *root = NULL;
+    cJSON *results;
+    cJSON *best = NULL;
+    int    best_rank = 9;
+    int    i;
+    int    total;
+
+    url_encode(name, enc, sizeof(enc));
+    snprintf(path, sizeof(path),
+             "/v1/search?name=%s&count=8&language=zh&format=json", enc);
+
+    buf = calloc(1, WEATHER_BUF_SIZE);
+    if (!buf) {
+        return ERROR;
+    }
+
+    status = https_get_json("geocoding-api.open-meteo.com", path, NULL,
+                            buf, WEATHER_BUF_SIZE);
+    if (status != 200) {
+        syslog(LOG_ERR, "[%s] Open-Meteo 地理编码 HTTP %d\n", TAG, status);
+        goto out;
+    }
+
+    root = cJSON_Parse(buf);
+    if (!root) {
+        goto out;
+    }
+
+    results = cJSON_GetObjectItem(root, "results");
+    total   = (results && cJSON_IsArray(results)) ?
+              cJSON_GetArraySize(results) : 0;
+
+    for (i = 0; i < total; i++) {
+        cJSON *r  = cJSON_GetArrayItem(results, i);
+        cJSON *fc = r ? cJSON_GetObjectItem(r, "feature_code") : NULL;
+        int    rk = geo_feature_rank(cJSON_IsString(fc) ? fc->valuestring : NULL);
+
+        if (rk < best_rank) {
+            best_rank = rk;
+            best      = r;
+        }
+    }
+
+    /* ★ 只认有人住的地方。全都是机场/河/山就当「没查到」，让上层继续截尾
+     * —— 否则「上海浦东」会答成浦东机场的天气。 */
+    if (!best || best_rank > 5) {
+        goto out;
+    }
+
+    {
+        cJSON *jlat = cJSON_GetObjectItem(best, "latitude");
+        cJSON *jlon = cJSON_GetObjectItem(best, "longitude");
+        cJSON *jnm  = cJSON_GetObjectItem(best, "name");
+        cJSON *jad1 = cJSON_GetObjectItem(best, "admin1");
+
+        if (!cJSON_IsNumber(jlat) || !cJSON_IsNumber(jlon)) {
+            goto out;
+        }
+
+        *lat = jlat->valuedouble;
+        *lon = jlon->valuedouble;
+
+        if (cJSON_IsString(jnm) && jnm->valuestring[0]) {
+            snprintf(disp, disp_cap, "%s", jnm->valuestring);
+        } else {
+            snprintf(disp, disp_cap, "%s", name);
+        }
+
+        /* ★ 2026-10-27：**别把「上海（上海市）」念出来**。实测 Open-Meteo 对
+         * 「上海」返回 name=上海 / admin1=上海市，两者只差一个「市」，括号里
+         * 那截纯属噪音，TTS 会念得很别扭。只有 admin1 真能区分时才补
+         * （「朝阳」到底是辽宁的还是北京的），补在括号里让 TTS 停一拍。 */
+        if (cJSON_IsString(jad1) && jad1->valuestring[0] &&
+            strncmp(jad1->valuestring, disp, strlen(disp)) != 0 &&
+            strncmp(disp, jad1->valuestring, strlen(jad1->valuestring)) != 0) {
+            size_t n = strlen(disp);
+            snprintf(disp + n, disp_cap - n, "（%s）", jad1->valuestring);
+        }
+    }
+
+    ret = OK;
+
+out:
+    if (root) {
+        cJSON_Delete(root);
+    }
+    free(buf);
+    return ret;
+}
+
+/* 城市名 → 经纬度。**两跳为主**：整串查一次，不行就跳到前两个字。
+ * 成功返回 OK 并填 lat/lon，disp 是解析出来的地名（口语用）。
+ *
+ * ★ 为什么不是「逐字截尾」而是「跳前两字」（2026-10-28 实测改的）：
+ *   逐字截尾对是对，但一次 HTTPS 往返要 ~5 秒，「北京中心→北京中→北京」
+ *   就是 3 个往返加天气 1 个 = 24 秒，比直接问大模型还慢。中国城市名
+ *   绝大多数两字（北京/上海/济南/广州），后面跟的「区县市中心新区」都是
+ *   尾巴 —— 一次失败就跳到前两个字，**4 个往返砍成 2 个**。
+ *   跳完还查不到再逐字截尾兜底，宁可多跑几次，也不瞎猜。
+ *   英文名不走这条（"New York" 截成 "Ne" 是瞎猜），老老实实逐字截。 */
+static int open_meteo_geocode(const char *name,
+                              double *lat, double *lon,
+                              char *disp, size_t disp_cap)
+{
+    /* 288：必须装下调用方那份 char location[256]。写 96 会被
+     * -Wformat-truncation 抓到，而且是**真**截断 —— 中间被砍掉的字会让
+     * 截尾链从一个不存在的半截名字开始往下截。加大缓冲，不是压告警。 */
+    char try_buf[288];
+    char head[288];
+    int  attempt = 0;
+
+    if (!name || !name[0]) {
+        return ERROR;
+    }
+
+    /* 命中缓存就一个往返都不走。 */
+    if (geo_cache_get(name, lat, lon, disp, disp_cap) == OK) {
+        syslog(LOG_INFO, "[%s] 地理编码命中缓存: %s → %s（省掉 HTTPS 往返）\n",
+               TAG, name, disp);
+        return OK;
+    }
+
+    snprintf(try_buf, sizeof(try_buf), "%s", name);
+
+    while (try_buf[0]) {
+        if (geocode_one(try_buf, lat, lon, disp, disp_cap) == OK) {
+            if (attempt > 0) {
+                syslog(LOG_INFO,
+                       "[%s] 地理编码截尾到「%s」才查到 → %s"
+                       "（原话「%s」带区县，Open-Meteo 不认）\n",
+                       TAG, try_buf, disp, name);
+            }
+            geo_cache_put(name, *lat, *lon, disp);
+            return OK;
+        }
+
+        /* 第一次失败：汉字名直接跳到前两个字，别一个字一个字地磨。 */
+        if (attempt == 0 && geo_starts_cjk(try_buf)) {
+            geo_take_head(try_buf, head, sizeof(head), 2);
+            if (head[0] && strcmp(head, try_buf) != 0) {
+                snprintf(try_buf, sizeof(try_buf), "%s", head);
+                attempt++;
+                continue;
+            }
+        }
+
+        if (++attempt > 5) {
+            break;
+        }
+        geo_drop_last(try_buf);
+    }
+
+    /* 全链都没查到 —— 交给上层退到搜索兜底 */
+    syslog(LOG_WARNING, "[%s] 地理编码没查到地方: %s（试了 %d 次都不认）\n",
+           TAG, name, attempt);
+    return ERROR;
+}
+
+/* ── 口语追加 ─────────────────────────────────────────────────────────
+ * ★ 为什么要包一层，不直接 `off += snprintf(...)`：snprintf 返回的是
+ *   "**想**写多少"，不是"真写了多少"。一旦 off 越过 cap，下一次
+ *   `output_size - off` 就下溢成一个巨大值，snprintf 会以为缓冲很大，
+ *   直接写穿堆。这是**真**的溢出，不是理论风险。 */
+static size_t say_cn(char *out, size_t cap, size_t off, const char *fmt, ...)
+{
+    va_list ap;
+    int     n;
+
+    if (off >= cap) {
+        return cap;
+    }
+    va_start(ap, fmt);
+    n = vsnprintf(out + off, cap - off, fmt, ap);
+    va_end(ap);
+    if (n < 0) {
+        return off;
+    }
+    off += (size_t)n;
+    return (off > cap) ? cap : off;
+}
+
+/* 「今天 / 明天 / 后天 / 大后天 / N 天后」。两个后端共用一套说法。 */
+static void weather_day_word(int day, char *buf, size_t cap)
+{
+    switch (day) {
+    case 0:  snprintf(buf, cap, "今天");  break;
+    case 1:  snprintf(buf, cap, "明天");  break;
+    case 2:  snprintf(buf, cap, "后天");  break;
+    case 3:  snprintf(buf, cap, "大后天"); break;
+    default: snprintf(buf, cap, "%d 天后", day); break;
+    }
+}
+
+/* ──────────────────────────────────────────────────────────────
+ * Backend 0+: 和风天气（QWeather）—— ★ 2026-10-29 ★
+ *
+ *   ① 城市搜索  GET /geo/v2/city/lookup?location=<城市>&lang=zh
+ *                → { "code":"200", "location":[{ "name","id","lat","lon",
+ *                       "adm1","adm2","type","rank" }] }
+ *   ② 实况      GET /weather/v1/current/{lat}/{lon}?lang=zh
+ *   ③ 逐日预报  GET /weather/v1/daily/{lat}/{lon}?lang=zh
+ *                → { "days":[7 条], "metadata" }
+ *
+ * ★ 这三个形状是**对着真接口 curl 出来的**（2026-10-29），不是照文档抄的：
+ *   - 城市搜索在**查询串**里，实况/预报是**路径段**。写成
+ *     `?location=lat,lon` 一律 404 —— 我第一版探针就栽在这儿：标签写的
+ *     `{lat}/{lon}`，f-string 里却是 `{lat},{lon}`，白信了一次 404。
+ *   - 回包**强制 gzip**（连 Accept-Encoding: identity 都照压），
+ *     vela_tls.c 不解 content-encoding，所以走 body_decompress + puff。
+ * ★ 城市搜索**直接认区县**（「济南历城区」一次就出历城），比 Open-Meteo
+ *   那条截尾链少 2~3 个往返 —— 而一次 HTTPS 往返就是 ~5 秒。
+ * ★ 挑法：**信和风自己的排序，取第一条**。别按 rank 最小挑 —— 实测
+ *   「济南历城区」第一条是历城（rank 25）、济南排第二（rank 11），
+ *   按 rank 挑会挑到错的那个。
+ * ★ 和风**要 key**，Open-Meteo 不要。所以和风排前面、**任何失败都自动退
+ *   回 Open-Meteo**：和风挂了天气这个功能还在。没配齐 key 就直接跳过
+ *   和风，那只是一条配置状态，不算故障。
+ * ──────────────────────────────────────────────────────────────*/
+
+/* 量出来的（2026-10-29，北京）：明文 city-lookup 2822B / current 682B /
+ * daily 12005B；压缩后 629B / 389B / 1837B。daily 是最大的那个。
+ * ★ 明文给 16KB：12005 已经贴着 12KB 了，省这 4KB 就是上一段注释里
+ *   "4KB 装 42KB" 那种坑。真装不下就解压失败 → 退 Open-Meteo，不崩。 */
+#define QW_GZ_SIZE    (8 * 1024)
+#define QW_PLAIN_SIZE (16 * 1024)
+
+/* 1970-01-01 = 0。Fliegel & Van Flandern 的整数日数，不碰 libc 的时区。 */
+static long ymd_to_daynum(int y, int m, int d)
+{
+    long a  = (14 - m) / 12;
+    long yy = y + 4800 - a;
+    long mm = m + 12 * a - 3;
+
+    return d + (153 * mm + 2) / 5 + 365 * yy + yy / 4 - yy / 100 + yy / 400
+           - 32045 - 2440588;
+}
+
+/* 取 ISO 串里连续 n 位数字。不引 sscanf —— 只为了拆 5 个数不值当。 */
+static int iso_digits(const char *s, int n)
+{
+    int v = 0;
+
+    while (n-- > 0 && *s >= '0' && *s <= '9') {
+        v = v * 10 + (*s - '0');
+        s++;
+    }
+    return v;
+}
+
+/* 和风 daily 的 forecastStartTime 是 UTC（实测 "2026-10-28T16:00Z"），
+ * 但它给的那条**是本地日历日**：东八区 16:00Z 就是次日 00:00。
+ * 所以先把时刻挪到本地再取日期。别抄"日期 +1 天"那种口诀 —— 时区一改就错。
+ * 实测（2026-10-29）：days[0].forecastStartTime = 2026-10-28T16:00Z
+ * → 本地 2026-10-29 00:00 = 今天，也就是 days[0] 就是今天。 */
+static long qw_daynum_of_start(const char *iso)
+{
+    int y, m, d, hh, mm;
+    int local_min;
+
+    if (!iso || strlen(iso) < 16) {
+        return -1;
+    }
+    y   = iso_digits(iso, 4);
+    m   = iso_digits(iso + 5, 2);
+    d   = iso_digits(iso + 8, 2);
+    hh  = iso_digits(iso + 11, 2);
+    mm  = iso_digits(iso + 14, 2);
+    if (y < 1970 || m < 1 || m > 12 || d < 1) {
+        return -1;
+    }
+
+    local_min = hh * 60 + mm + 8 * 60;      /* UTC → UTC+8 */
+    if (local_min >= 24 * 60) {
+        return ymd_to_daynum(y, m, d) + 1;
+    }
+    return ymd_to_daynum(y, m, d);
+}
+
+/* 今天（东八区的日历日）。★ 自己加 8 小时再走 gmtime_r，不赌 localtime_r：
+ * NuttX 的 localtime_r 要去 romfs 翻 zoneinfo，翻不到就整个错
+ * （tool_get_time.c:262 同样的理由）。设备就是国内用的，UTC+8 写死是对的。 */
+static long weather_today_daynum(void)
+{
+    time_t    t = time(NULL) + (time_t)(8 * 3600);
+    struct tm tmv;
+
+    if (gmtime_r(&t, &tmv) == NULL) {
+        return -1;
+    }
+    return ymd_to_daynum(tmv.tm_year + 1900, tmv.tm_mon + 1, tmv.tm_mday);
+}
+
+/* 和风的数值有两种形状：裸数（humidity = 0.45）和 {value,unit} 包着的
+ * （temperature:{value:12.82,unit:"°C"}）。两种都认，省得每处写两遍。 */
+static int qw_field_num(cJSON *parent, const char *key, double *out)
+{
+    cJSON *f = cJSON_GetObjectItem(parent, key);
+    cJSON *v;
+
+    if (!f) {
+        return ERROR;
+    }
+    if (cJSON_IsNumber(f)) {
+        *out = f->valuedouble;
+        return OK;
+    }
+    v = cJSON_GetObjectItem(f, "value");
+    if (cJSON_IsNumber(v)) {
+        *out = v->valuedouble;
+        return OK;
+    }
+    return ERROR;
+}
+
+/* parent.condition.text —— 天气现象本来就是中文（'晴'/'多云'/'小雨'），
+ * 不用像 Open-Meteo 那样过 wmo_to_cn。 */
+static int qw_cond_text(cJSON *parent, const char **out)
+{
+    cJSON *c = cJSON_GetObjectItem(parent, "condition");
+    cJSON *t = c ? cJSON_GetObjectItem(c, "text") : NULL;
+
+    if (cJSON_IsString(t) && t->valuestring[0]) {
+        *out = t->valuestring;
+        return OK;
+    }
+    return ERROR;
+}
+
+/* 风向：和风回 degree（0~360）和英文缩写（"ssw"）。念给老人听要中文 ——
+ * 用度数切 8 方位，比建一张 16 项英文缩写表短，也少一处对不上的地方。 */
+static const char *qw_wind_dir_cn(double degree)
+{
+    static const char *const names[8] = {
+        "北", "东北", "东", "东南", "南", "西南", "西", "西北"
+    };
+    long idx = (long)((degree + 22.5) / 45.0);
+
+    if (idx < 0) {
+        idx = 0;
+    }
+    return names[idx % 8];
+}
+
+/* 和风的比例值 → 百分数。
+ * ★ 实测 humidity 是 **0..1 的小数**（0.45 = 45%），不是百分数 ——
+ *   Open-Meteo 的 relative_humidity_2m 已经是百分数，两家别抄混。
+ *   precipitation.probability 同样按比例处理。 */
+static int qw_pct(double frac, int *out)
+{
+    *out = (int)(frac * 100.0 + 0.5);
+    return OK;
+}
+
+/* 和风：GET <path>，鉴权走 X-QW-Api-Key。
+ * ★ **别再加别的鉴权头** —— 和风文档明确写了不要混用鉴权方式。
+ * 成功把解压后的 JSON 写进 plain（NUL 结尾），长度写进 plain_len。 */
+static int qweather_get(const char *path,
+                        char *plain, size_t plain_cap, size_t *plain_len)
+{
+    vela_header_t hdrs[2];
+    char         *gz;
+    size_t        gz_len = 0;
+    int           status;
+    int           ret = ERROR;
+
+    if (!s_qweather_host[0] || !s_qweather_key[0]) {
+        return ERROR;                    /* 没配齐 = 走 Open-Meteo，不是故障 */
+    }
+
+    gz = calloc(1, QW_GZ_SIZE);
+    if (!gz) {
+        return ERROR;
+    }
+
+    hdrs[0].name  = "X-QW-Api-Key";
+    hdrs[0].value = s_qweather_key;
+    hdrs[1].name  = NULL;
+    hdrs[1].value = NULL;
+
+    status = https_get_raw(s_qweather_host, path, hdrs, gz, QW_GZ_SIZE, &gz_len);
+    if (status != 200) {
+        syslog(LOG_WARNING, "[%s] 和风 HTTP %d\n", TAG, status);
+        goto out;
+    }
+    if (gz_len == 0) {
+        goto out;
+    }
+
+    ret = body_decompress(gz, gz_len, plain, plain_cap, plain_len);
+    if (ret != OK) {
+        syslog(LOG_WARNING, "[%s] 和风回包解不开（gzip %zu 字节）\n", TAG, gz_len);
+    }
+
+out:
+    free(gz);
+    return ret;
+}
+
+/* 城市名 → 经纬度 + 口语地名。★ 取和风排序的第一条（理由见上面那段）。
+ * 地名这么拼：先试 "上级市 + 本名"（历城 → 济南历城，浦东新区 → 上海浦东
+ * 新区），拼不出来再退回本名，实在要区分才补（省名）—— 跟 Open-Meteo
+ * 那条同一个纪律，别念出「上海（上海市）」这种废话。 */
+static int qweather_geocode(const char *name, double *lat, double *lon,
+                            char *disp, size_t disp_cap)
+{
+    char   enc[768];
+    char   path[1024];
+    char  *plain;
+    size_t plain_len = 0;
+    int    ret = ERROR;
+    cJSON *root = NULL;
+    cJSON *loc;
+    cJSON *best;
+
+    if (!name || !name[0]) {
+        return ERROR;
+    }
+
+    /* 命中缓存就一个往返都不走。两个后端共用这一份缓存。 */
+    if (geo_cache_get(name, lat, lon, disp, disp_cap) == OK) {
+        syslog(LOG_INFO, "[%s] 地理编码命中缓存: %s → %s（省掉 HTTPS 往返）\n",
+               TAG, name, disp);
+        return OK;
+    }
+
+    plain = calloc(1, QW_PLAIN_SIZE);
+    if (!plain) {
+        return ERROR;
+    }
+
+    url_encode(name, enc, sizeof(enc));
+    snprintf(path, sizeof(path), "/geo/v2/city/lookup?location=%s&lang=zh", enc);
+
+    if (qweather_get(path, plain, QW_PLAIN_SIZE, &plain_len) != OK) {
+        goto out;
+    }
+
+    root = cJSON_Parse(plain);
+    if (!root) {
+        goto out;
+    }
+
+    loc = cJSON_GetObjectItem(root, "location");
+    best = (loc && cJSON_IsArray(loc) && cJSON_GetArraySize(loc) > 0) ?
+           cJSON_GetArrayItem(loc, 0) : NULL;
+    if (!best) {
+        goto out;
+    }
+
+    {
+        cJSON *jlat  = cJSON_GetObjectItem(best, "lat");
+        cJSON *jlon  = cJSON_GetObjectItem(best, "lon");
+        cJSON *jname = cJSON_GetObjectItem(best, "name");
+        cJSON *jad1  = cJSON_GetObjectItem(best, "adm1");
+        cJSON *jad2  = cJSON_GetObjectItem(best, "adm2");
+        const char *nm  = cJSON_IsString(jname) ? jname->valuestring : name;
+        const char *ad1 = cJSON_IsString(jad1)  ? jad1->valuestring  : "";
+        const char *ad2 = cJSON_IsString(jad2)  ? jad2->valuestring  : "";
+        size_t      n;
+
+        /* 和风的 lat/lon 是**字符串**（"39.90499"），不是数。 */
+        if (!cJSON_IsString(jlat) || !cJSON_IsString(jlon)) {
+            goto out;
+        }
+        *lat = atof(jlat->valuestring);
+        *lon = atof(jlon->valuestring);
+
+        snprintf(disp, disp_cap, "%s", nm);
+
+        /* 「历城」+ 上级「济南」→ 「济南历城」。互相包含就不拼
+         * （北京/北京、朝阳县/朝阳 拼起来只会更啰嗦）。 */
+        n = strlen(disp);
+        if (ad2[0] && strcmp(ad2, nm) != 0 &&
+            strstr(nm, ad2) == NULL && strstr(ad2, nm) == NULL) {
+            snprintf(disp, disp_cap, "%s%s", ad2, nm);
+            n = strlen(disp);
+        }
+
+        /* 还分不清才补（省名），且要去掉「省/市」——「辽宁省」念出来很硬。 */
+        if (ad1[0] && disp[0] && strstr(ad1, disp) == NULL &&
+            strstr(disp, ad1) == NULL) {
+            char trimmed[64];
+            size_t k = 0;
+
+            while (ad1[k] && k < sizeof(trimmed) - 1 &&
+                   (unsigned char)ad1[k] >= 0x20) {
+                trimmed[k] = ad1[k];
+                k++;
+            }
+            trimmed[k] = '\0';
+            if (k > 3) {
+                /* 只砍尾巴上一个「省」「市」「自治区」，够用。 */
+                char *p = strstr(trimmed, "省");
+                if (p && p[1] == '\0') {
+                    *p = '\0';
+                }
+                p = strstr(trimmed, "市");
+                if (p && p[1] == '\0') {
+                    *p = '\0';
+                }
+            }
+            if (trimmed[0]) {
+                snprintf(disp + n, disp_cap - n, "（%s）", trimmed);
+            }
+        }
+    }
+
+    geo_cache_put(name, *lat, *lon, disp);
+    syslog(LOG_INFO, "[%s] 和风城市搜索: %s → %s\n", TAG, name, disp);
+    ret = OK;
+
+out:
+    if (root) {
+        cJSON_Delete(root);
+    }
+    free(plain);
+    return ret;
+}
+
+/* 从 days 里挑出「今天 + day」那条。
+ * 按 forecastStartTime 换算出的本地日历日对，对不上才按条目序号兜底
+ * （实测 days[0] 就是今天，但那是**结论**，别当规则用）。 */
+static cJSON *qweather_pick_day(cJSON *days, int day)
+{
+    long target = weather_today_daynum();
+    int  n = cJSON_IsArray(days) ? cJSON_GetArraySize(days) : 0;
+    int  i;
+
+    if (target >= 0) {
+        target += day;
+        for (i = 0; i < n; i++) {
+            cJSON *d  = cJSON_GetArrayItem(days, i);
+            cJSON *st = d ? cJSON_GetObjectItem(d, "forecastStartTime") : NULL;
+
+            if (cJSON_IsString(st) &&
+                qw_daynum_of_start(st->valuestring) == target) {
+                return d;
+            }
+        }
+    }
+    return (day >= 0 && day < n) ? cJSON_GetArrayItem(days, day) : NULL;
+}
+
+/* 和风主入口。拿到就直接把**口语中文**写进 output；失败返回 ERROR 并把
+ * output 清空（让上层能放心接着试下一个后端）。 */
+static int qweather_weather(const char *location, int day,
+                            char *output, size_t output_size)
+{
+    double    lat = 0.0, lon = 0.0;
+    char      disp[288];
+    char      word[16];
+    char      path[256];
+    char     *plain = NULL;
+    size_t    plain_len = 0;
+    long long t0;
+    cJSON    *root = NULL;      /* daily 那棵树 */
+    cJSON    *cur  = NULL;      /* current 那棵树，两棵**分开**，别互相覆盖 */
+    cJSON    *days = NULL;
+    cJSON    *d    = NULL;
+    size_t    off  = 0;
+    int       ret  = ERROR;
+    int       have_now = 0;
+
+    output[0] = '\0';
+    disp[0]   = '\0';
+    weather_day_word(day, word, sizeof(word));
+
+    t0 = mono_ms();
+    if (qweather_geocode(location, &lat, &lon, disp, sizeof(disp)) != OK) {
+        return ERROR;
+    }
+
+    snprintf(path, sizeof(path), "/weather/v1/daily/%.4f/%.4f?lang=zh", lat, lon);
+
+    plain = calloc(1, QW_PLAIN_SIZE);
+    if (!plain) {
+        return ERROR;
+    }
+
+    if (qweather_get(path, plain, QW_PLAIN_SIZE, &plain_len) != OK) {
+        goto out;
+    }
+    root = cJSON_Parse(plain);
+    if (!root) {
+        goto out;
+    }
+    days = cJSON_GetObjectItem(root, "days");
+    d = qweather_pick_day(days, day);
+    if (!d) {
+        syslog(LOG_WARNING, "[%s] 和风 daily 里没有第 %d 天\n", TAG, day);
+        goto out;
+    }
+
+    /* ★ 实况只在问「今天」时才多跑一次：那是**第二个** HTTPS 往返
+     * （~5 秒），问明天的时候它一点用都没有。 */
+    if (day == 0) {
+        double      t, feels, hum;
+        double      wdeg = -1.0, wscale = -1.0;
+        int         pct;
+        const char *cond = NULL;
+        cJSON      *w;
+
+        snprintf(path, sizeof(path), "/weather/v1/current/%.4f/%.4f?lang=zh",
+                 lat, lon);
+        plain_len = 0;
+        if (qweather_get(path, plain, QW_PLAIN_SIZE, &plain_len) == OK) {
+            cur = cJSON_Parse(plain);
+        }
+        if (cur && qw_field_num(cur, "temperature", &t) == OK) {
+            have_now = 1;
+            off = say_cn(output, output_size, off, "%s现在 %.0f 度",
+                         disp[0] ? disp : location, t);
+            if (qw_cond_text(cur, &cond) == OK) {
+                off = say_cn(output, output_size, off, "，%s", cond);
+            }
+            if (qw_field_num(cur, "feelsLike", &feels) == OK) {
+                off = say_cn(output, output_size, off, "，体感 %.0f 度", feels);
+            }
+            if (qw_field_num(cur, "humidity", &hum) == OK) {
+                qw_pct(hum, &pct);
+                off = say_cn(output, output_size, off, "，湿度 %d%%", pct);
+            }
+
+            /* wind 是 { direction:{degree,compass}, scale, speed:{...} }。 */
+            w = cJSON_GetObjectItem(cur, "wind");
+            if (w) {
+                cJSON *wd = cJSON_GetObjectItem(w, "direction");
+
+                if (wd) {
+                    qw_field_num(wd, "degree", &wdeg);
+                }
+                qw_field_num(w, "scale", &wscale);
+            }
+            if (wdeg >= 0.0 && wscale >= 0.0) {
+                off = say_cn(output, output_size, off, "，%s风 %.0f 级",
+                             qw_wind_dir_cn(wdeg), wscale);
+            }
+            off = say_cn(output, output_size, off, "。");
+        }
+    }
+
+    /* daily 那一段：白天天气 + 最高/最低，问哪天都说。 */
+    {
+        double      tmax, tmin, pop;
+        double      wdeg = -1.0, wscale = -1.0;
+        int         pct;
+        const char *cond = NULL;
+        cJSON      *daytime = cJSON_GetObjectItem(d, "daytime");
+        cJSON      *w;
+        cJSON      *p;
+
+        if (daytime) {
+            qw_cond_text(daytime, &cond);
+        }
+
+        /* 实况那段已经把地名和天气现象说过一遍了，这里只补「白天」那一半，
+         * 免得一句里念两遍「晴」。 */
+        if (have_now) {
+            off = say_cn(output, output_size, off, "%s白天%s", word,
+                         cond ? cond : "天气");
+        } else {
+            off = say_cn(output, output_size, off, "%s%s%s",
+                         disp[0] ? disp : location, word, cond ? cond : "天气");
+        }
+
+        if (qw_field_num(d, "temperatureMax", &tmax) == OK) {
+            off = say_cn(output, output_size, off, "，最高 %.0f 度", tmax);
+        }
+        if (qw_field_num(d, "temperatureMin", &tmin) == OK) {
+            off = say_cn(output, output_size, off, "，最低 %.0f 度", tmin);
+        }
+
+        w = daytime ? cJSON_GetObjectItem(daytime, "wind") : NULL;
+        if (w) {
+            cJSON *wd = cJSON_GetObjectItem(w, "direction");
+
+            if (wd) {
+                qw_field_num(wd, "degree", &wdeg);
+            }
+            qw_field_num(w, "scale", &wscale);
+        }
+        if (wdeg >= 0.0 && wscale >= 0.0) {
+            off = say_cn(output, output_size, off, "，%s风 %.0f 级",
+                         qw_wind_dir_cn(wdeg), wscale);
+        }
+
+        p = daytime ? cJSON_GetObjectItem(daytime, "precipitation") : NULL;
+        if (p && qw_field_num(p, "probability", &pop) == OK) {
+            qw_pct(pop, &pct);
+            if (pct > 0) {
+                off = say_cn(output, output_size, off, "，下雨的概率 %d%%", pct);
+            }
+        }
+        off = say_cn(output, output_size, off, "。");
+    }
+
+    if (off == 0) {
+        goto out;
+    }
+
+    syslog(LOG_INFO, "[%s] 和风天气: %s（%lld ms，第 %d 天）\n",
+           TAG, output, mono_ms() - t0, day);
+    ret = OK;
+
+out:
+    if (cur) {
+        cJSON_Delete(cur);
+    }
+    if (root) {
+        cJSON_Delete(root);
+    }
+    free(plain);
+    if (ret != OK) {
+        output[0] = '\0';       /* 别让半截话被上层当成成功 */
+    }
+    return ret;
