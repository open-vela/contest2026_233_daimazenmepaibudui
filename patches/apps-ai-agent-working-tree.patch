+/* 这句话可不可以进缓存？**只有「答案不会过期的」才进**。
+ *
+ * 缓存存的是上一次的答案，而答案随**时间**和**上下文**变：「今天天气怎么样」
+ * 早上问晚上问不是一回事，先聊了北京再问也不是一回事。真机 2026-10-29 被
+ * 这个咬了一口 —— 同一句「你好你好，今天天气怎么样？」第二次问时命中缓存、
+ * 没走大模型，答出的却是几轮前提过的北京的天气；真送大模型那次答的是
+ * 「我得先知道您在哪个城市」，是对的。缓存答了一个他没问的问题，这正是
+ * 本工程一贯认定的「比不答更糟」。
+ *
+ * 判据定得**很紧**，一律往「不进」那边偏 —— 少缓存一条只慢几秒，
+ * 多缓存一条会答错。三道门全过才进：
+ *   ① 短：长句多半带着具体的事，答案难保不过期；
+ *   ② 不是疑问句：问号**和**疑问词都算（ASR 转写出来的句子常常**没有问号**，
+ *      「今天天气怎么样」就是光秃秃一句，只挡问号挡不住它）；
+ *   ③ 不提会过期的话题：时间/天气/新闻/行情……
+ * 寒暄客套（「你好你好」「嗯」）三道门都过，进缓存、第二次秒回。 */
+static bool cacheable_utterance(const char* text)
+{
+    /* ② 疑问词。★ 必须按 UTF-8 整字符找，不能拿单个 char 比 ——
+     * 「吗」是三个字节，strchr 是按字节找、会误命中别的汉字。 */
+    static const char* const s_not_cacheable[] = {
+        "?", "？", "吗", "呢", "怎么", "什么", "哪", "谁", "几",
+        "多少", "为什么", "多久", "多长", "是不是", "有没有",
+        /* ③ 会过期的话题 */
+        "天气", "今天", "明天", "昨天", "后天", "现在", "几点",
+        "时间", "日期", "星期", "新闻", "消息", "市场", "行情",
+        "股票", "温度", "多少度", "几号", "直播", "比分",
+        NULL
+    };
+
+    size_t n;
+
+    if (!text || !text[0]) {
+        return false;
+    }
+    n = strlen(text);
+    if (n >= 16) {
+        return false;
+    }
+    for (int i = 0; s_not_cacheable[i]; i++) {
+        if (strstr(text, s_not_cacheable[i]) != NULL) {
+            return false;
+        }
+    }
+    return true;
+}
