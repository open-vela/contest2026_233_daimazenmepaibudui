+/* ──────────────────────────────────────────────────────────────
+ * Backend 3.5: 新浪财经滚动新闻 —— ★ 2026-10-27 ★ **不要 key**
+ *
+ *   GET https://feed.mix.sina.com.cn/api/roll/get
+ *       ?pageid=153&lid=2516&num=10&page=1
+ *   → { "result": { "data": [ { "title","ctime","media_name","url" } ] } }
+ *
+ * ★★ 两个坑，都是实测出来的，别想当然：
+ *   ① 它的 `k=` 关键词参数**不生效**。实测 k=股票 / k=不存在的词xyzzy /
+ *      k=（空）返回**一模一样**的 20 条。所以这不是搜索引擎，是滚动流。
+ *      → 下面用「按标题字重合度本地排序」来救：问「股票」时把沾边的标题
+ *        排前面。救不了就把整条流给出去，并在开头**明说**这是滚动市场要闻、
+ *        不是按词搜出来的 —— 让大模型老实回答「查不到」，别拿不相干的
+ *        标题硬编。
+ *   ② Google News RSS 在这个网络里**完全连不上**（中英文都 http=000，
+ *      超时 15s）。本来想拿它当免 key 的通用新闻兜底，**不成立，别再试**。
+ *
+ * ★ 为什么值得做：用户原话是「找不到市场上实时的信息」。财经滚动流正好
+ *   就是这个，而且免 key、免注册。这是本次「联网」里唯一不靠 key 能拿到
+ *   实时信息的路子。
+ * ──────────────────────────────────────────────────────────────*/
+
+/* ★★ 缓冲大小是量出来的，不是猜的 —— 别再拍脑袋（前科见下）★★
+ *
+ *   实测同一接口按 num 给多少（主机直连，2026-10-27）：
+ *       num=5  → 10557 字节      num=15 → 30928 字节
+ *       num=10 → 20716 字节      num=20 → 42209 字节
+ *
+ *   旧代码是 `num=20` + `SINA_BUF_SIZE 16*1024` —— **42209 字节的回包塞进
+ *   16384 字节的缓冲，必然被砍到只剩尾巴**。而 `https_get_json` 是「静默
+ *   截断」（见 vela_tls.h），不报错。于是 cJSON_Parse 拿到半截 JSON 失败，
+ *   串口只有一句 `新浪财经返回的不是 JSON`，看上去像接口变了，其实是缓冲
+ *   不够 —— 我自己的主机测试里明明写着 42504，却没跟 16KB 这个数连起来。
+ *
+ *   现在：num 降到 10（挑 5 条够用，条数翻倍也没多给信息），缓冲给到
+ *   28KB 留足余量；并且**强制打印收到多少字节**，一旦撞到缓冲上限就打
+ *   ★ 截断告警 —— 让这类问题下次在串口上直接看得见，不用再猜。
+ *
+ *   ⚠️ 这是堆上临时 calloc，SRAM 已用 77%，28KB 是挑过的：太大会挤到
+ *   TTS 那 900KB 的分配，太小又要回头改。要改请先重跑上面那张表。 */
+#define SINA_BUF_SIZE  (28 * 1024)
+#define SINA_TAKE      5
+#define SINA_MAX_ITEMS 32
+
+static const char *find_sub(const char *hay, size_t hay_len,
+                            const char *needle, size_t needle_len)
+{
+    size_t i;
+
+    if (needle_len == 0 || hay_len < needle_len) {
+        return NULL;
+    }
+    for (i = 0; i + needle_len <= hay_len; i++) {
+        if (memcmp(hay + i, needle, needle_len) == 0) {
+            return hay + i;
+        }
+    }
+    return NULL;
+}
+
+/* 把 Unix 时间戳翻成念得出口的话（「X 分钟前」）。
+ * 时间没同步、或这条太老，就返回空串 —— **宁可不说，也不瞎说**。 */
+static void rel_time_cn(char *dst, size_t cap, long long ctime)
+{
+    long long d;
+
+    if (cap == 0) {
+        return;
+    }
+    dst[0] = '\0';
+    if (ctime <= 0) {
+        return;
+    }
+    d = (long long)time(NULL) - ctime;
+    if (d < 0 || d > 2LL * 86400) {
+        return;
+    }
+    if (d < 60) {
+        snprintf(dst, cap, "刚刚");
+    } else if (d < 3600) {
+        snprintf(dst, cap, "%lld 分钟前", d / 60);
+    } else if (d < 86400) {
+        snprintf(dst, cap, "%lld 小时前", d / 3600);
+    } else {
+        snprintf(dst, cap, "%lld 天前", d / 86400);
+    }
+}
+
+/* query 对标题的重合度。**按「字」不按「词」**：
+ * 「股票」在「股价一个月暴跌 37%」里根本不出现，子串匹配一条都捞不到，
+ * 但老人问的就是这事。UTF-8 逐字符走，只算汉字和英数，标点空白不算
+ * （否则每条标题都白涨分，排序就废了）。 */
+static int title_score(const char *title, const char *query)
+{
+    const char *q = query;
+    size_t      tlen = strlen(title);
+    int         score = 0;
+
+    while (*q) {
+        unsigned char c = (unsigned char)*q;
+        int  clen;
+        char one[8];
+
+        if (c < 0x80) {
+            clen = 1;
+        } else if ((c & 0xE0) == 0xC0) {
+            clen = 2;
+        } else if ((c & 0xF0) == 0xE0) {
+            clen = 3;
+        } else if ((c & 0xF8) == 0xF0) {
+            clen = 4;
+        } else {
+            clen = 1;              /* 容错：乱字节按 1 字节走，别死循环 */
+        }
+        if (q[clen - 1] == '\0') {
+            clen = (int)strlen(q); /* 别越过串尾 */
+        }
+
+        /* 只算汉字和英数，标点/空白不算分 */
+        if (c >= 0x80 || (c >= '0' && c <= '9') ||
+            (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')) {
+            memcpy(one, q, clen);
+            one[clen] = '\0';
+            if (find_sub(title, tlen, one, (size_t)clen) != NULL) {
+                score++;
+            }
+        }
+
+        q += clen;
+    }
+    return score;
+}
+
+/* 免 key 主后端：拿新浪财经滚动流，按相关度排，输出念得出口的中文。
+ * 成功返回 OK；连不上/解析不了返回 ERROR，**不碰 output**，好让上层兜底。 */
+static int sina_finance_news(const char *query, char *output, size_t output_size)
+{
+    char   path[256];
+    char  *buf;
+    size_t got;
+    int    status;
+    int    ret = ERROR;
+    cJSON *root = NULL;
+    cJSON *result;
+    cJSON *data;
+    int    total;
+    int    score[SINA_MAX_ITEMS];
+    int    used[SINA_MAX_ITEMS];
+    cJSON *items[SINA_MAX_ITEMS];
+    size_t off = 0;
+    int    i;
+    int    n;
+    int    weak;
+
+    snprintf(path, sizeof(path),
+             "/api/roll/get?pageid=153&lid=2516&k=&num=10&page=1");
+
+    buf = calloc(1, SINA_BUF_SIZE);
+    if (!buf) {
+        return ERROR;
+    }
+
+    status = https_get_json("feed.mix.sina.com.cn", path, NULL,
+                            buf, SINA_BUF_SIZE);
+    if (status != 200) {
+        syslog(LOG_ERR, "[%s] 新浪财经 HTTP %d\n", TAG, status);
+        goto out;
+    }
+
+    /* ★ 强制报收到多少字节 + 撞没撞缓冲顶。旧版没这两行，缓冲被砍得只剩
+     * 尾巴时串口上看不出来，只能看到一句「不是 JSON」，白排查一轮。 */
+    got = strlen(buf);
+    syslog(LOG_INFO, "[%s] 新浪回包 %zu 字节（缓冲 %d）\n",
+           TAG, got, SINA_BUF_SIZE);
+    if (got >= (size_t)SINA_BUF_SIZE - 1) {
+        syslog(LOG_WARNING,
+               "[%s] ★ 新浪回包被截断（收到 %zu 字节 == 缓冲顶 %d）—— "
+               "下面解析肯定失败，把 SINA_BUF_SIZE 调大\n",
+               TAG, got, SINA_BUF_SIZE - 1);
+        goto out;
+    }
+
+    root = cJSON_Parse(buf);
+    if (!root) {
+        syslog(LOG_ERR, "[%s] 新浪财经返回的不是 JSON（收到 %zu 字节）\n",
+               TAG, got);
+        goto out;
+    }
+
+    result = cJSON_GetObjectItem(root, "result");
+    data   = result ? cJSON_GetObjectItem(result, "data") : NULL;
+    total  = (data && cJSON_IsArray(data)) ? cJSON_GetArraySize(data) : 0;
+    if (total <= 0) {
+        syslog(LOG_WARNING, "[%s] 新浪财经没给数据\n", TAG);
+        goto out;
+    }
+    if (total > (int)(sizeof(items) / sizeof(items[0]))) {
+        total = (int)(sizeof(items) / sizeof(items[0]));
+    }
+
+    for (i = 0; i < total; i++) {
+        cJSON *it = cJSON_GetArrayItem(data, i);
+        cJSON *t  = it ? cJSON_GetObjectItem(it, "title") : NULL;
+
+        items[i] = it;
+        used[i]  = 0;
+        score[i] = (t && cJSON_IsString(t)) ? title_score(t->valuestring, query) : 0;
+    }
+
+    /* ★ 关键：把「这是滚动流、不是搜出来的」写在 output **开头**。
+     * 不写这句，大模型会把不相干的标题当成对你问题的回答硬编出来。 */
+    if (query[0] == '\0') {
+        off += snprintf(output + off, output_size - off,
+                        "（以下是新浪财经的最新市场要闻。）\n");
+    } else {
+        off += snprintf(output + off, output_size - off,
+                        "（以下是新浪财经的**最新市场要闻**，不是按「%s」搜出来的"
+                        "—— 这个接口不支持关键词搜索，只能给最新的，"
+                        "已按标题相关度排过。查不到就老实说查不到。）\n",
+                        query);
+    }
+
+    /* 挑分最高的 SINA_TAKE 条。10 里挑 5，「每趟扫最大」的土办法就够，
+     * 不上 qsort —— 少一个不稳定的排序环节。 */
+    weak = 1;
+    for (n = 0; n < SINA_TAKE; n++) {
+        int best = -1;
+        for (i = 0; i < total; i++) {
+            if (used[i]) {
+                continue;
+            }
+            if (best < 0 || score[i] > score[best]) {
+                best = i;
+            }
+        }
+        if (best < 0) {
+            break;
+        }
+        used[best] = 1;
+        if (score[best] > 0) {
+            weak = 0;
+        }
+
+        {
+            cJSON *it   = items[best];
+            cJSON *t    = cJSON_GetObjectItem(it, "title");
+            cJSON *src  = cJSON_GetObjectItem(it, "media_name");
+            cJSON *ct   = cJSON_GetObjectItem(it, "ctime");
+            char   when[32];
+
+            rel_time_cn(when, sizeof(when),
+                        ct && cJSON_IsNumber(ct) ? (long long)ct->valuedouble : 0);
+
+            off += snprintf(output + off, output_size - off, "%d. %s（%s%s%s）\n",
+                            n + 1,
