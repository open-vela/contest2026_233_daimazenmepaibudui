diff --git a/src/llm/llm_router.c b/src/llm/llm_router.c
index aa586f2..17922c3 100644
--- a/src/llm/llm_router.c
+++ b/src/llm/llm_router.c
@@ -405,6 +405,32 @@ static int router_select_internal(llm_complexity_t complexity,
         }
     }
 
+    /* ★ 最后一道活路：只要还有一个已启用的后端，就绝不返回 -1
+     *
+     * 2026-10-23 真机现象："一开始能对话，越来越不稳，后面完全不能对话"。
+     * 追下来是这里的空档：本机只配了 1 个后端（llm_backend_0），而
+     * router_select_internal 对 fail_count >= MAX_CONSECUTIVE_FAILURES(3) 的
+     * 后端是直接 continue 掉的（见上），既不给 best_idx 也不给 fallback_idx，
+     * 于是 best_idx == -1 且 fallback_idx == -1，调用方拿到 -1 就当"没有后端"，
+     * 每个请求都在本地直接失败 —— 而且要等 RECOVERY_INTERVAL_SEC(300 秒)
+     * 才会放出来。用户看到的就是整整五分钟"彻底不能对话"。
+     *
+     * 单后端设备根本没有"换个后端"这回事：退避（0/2/4/8/.../60s）已经做过
+     * 限流了，这里再一票否决五分钟是过度惩罚。所以宁可硬着头皮再试一次 ——
+     * 只要成功一次，report_success() 就会把 fail_count / backoff_until 清零。 */
+    if (best_idx < 0) {
+        for (int i = 0; i < LLM_ROUTER_MAX_BACKENDS; i++) {
+            if (s_backends[i].enabled && s_backends[i].host[0] != '\0') {
+                best_idx = i;
+                syslog(LOG_WARNING,
+                    "[%s] All backends penalized, last-resort to backend %d "
+                    "(fail_count=%d)\n",
+                    TAG, i, s_backends[i].fail_count);
+                break;
+            }
+        }
+    }
+
     return best_idx;
 }
 
