+    char   word[16];
+    char   path[512];
+    char  *buf;
+    int    status;
+    int    ret = ERROR;
+    cJSON *root = NULL;
+    cJSON *cur;
+    cJSON *daily;
+    size_t off = 0;
+
+    disp[0] = '\0';
+    weather_day_word(day, word, sizeof(word));
+    if (open_meteo_geocode(location, &lat, &lon, disp, sizeof(disp)) != OK) {
