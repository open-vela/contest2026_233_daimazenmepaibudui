+    buf = calloc(1, WEATHER_BUF_SIZE);
+    if (!buf) {
+        return ERROR;
+    }
+
+    status = https_get_json("api.open-meteo.com", path, NULL,
+                            buf, WEATHER_BUF_SIZE);
+    if (status != 200) {
+        syslog(LOG_ERR, "[%s] Open-Meteo 预报 HTTP %d\n", TAG, status);
+        goto out;
+    }
+
+    root = cJSON_Parse(buf);
+    if (!root) {
+        goto out;
+    }
+
+    cur = cJSON_GetObjectItem(root, "current");
+    if (!cur) {
+        goto out;
+    }
+
+    {
+        cJSON *jt   = cJSON_GetObjectItem(cur, "temperature_2m");
+        cJSON *jhum = cJSON_GetObjectItem(cur, "relative_humidity_2m");
+        cJSON *japp = cJSON_GetObjectItem(cur, "apparent_temperature");
+        cJSON *jcode= cJSON_GetObjectItem(cur, "weather_code");
+        cJSON *jwind= cJSON_GetObjectItem(cur, "wind_speed_10m");
+
+        if (!cJSON_IsNumber(jt)) {
+            goto out;
+        }
+
+        /* ★ 问别的日子时**别报实况当答案**：那句「现在 X 度」是当场的，
+         * 跟「明天多少度」没关系。到那天的高低在下面 daily 那一段。 */
+        if (day == 0) {
+            off = say_cn(output, output_size, off, "%s现在 %.0f 度，%s",
+                         disp[0] ? disp : location, jt->valuedouble,
+                         wmo_to_cn(cJSON_IsNumber(jcode) ? (int)jcode->valuedouble : -1));
+
+            if (cJSON_IsNumber(japp)) {
+                off = say_cn(output, output_size, off,
+                             "，体感 %.0f 度", japp->valuedouble);
+            }
+            if (cJSON_IsNumber(jhum)) {
+                off = say_cn(output, output_size, off,
+                             "，湿度 %d%%", (int)(jhum->valuedouble + 0.5));
+            }
+            if (cJSON_IsNumber(jwind)) {
+                off = say_cn(output, output_size, off,
+                             "，风速 %.0f 公里每小时", jwind->valuedouble);
+            }
+            off = say_cn(output, output_size, off, "。");
+        }
+    }
+
+    daily = cJSON_GetObjectItem(root, "daily");
+    if (daily) {
+        cJSON *jmax = cJSON_GetObjectItem(daily, "temperature_2m_max");
+        cJSON *jmin = cJSON_GetObjectItem(daily, "temperature_2m_min");
+        cJSON *jpop = cJSON_GetObjectItem(daily, "precipitation_probability_max");
+
+        /* daily 里全是**数组**，取第 day 天（forecast_days 已经盖住了）。 */
+        jmax = jmax ? cJSON_GetArrayItem(jmax, day) : NULL;
+        jmin = jmin ? cJSON_GetArrayItem(jmin, day) : NULL;
+        jpop = jpop ? cJSON_GetArrayItem(jpop, day) : NULL;
+
+        if (cJSON_IsNumber(jmax) || cJSON_IsNumber(jmin)) {
+            /* day==0 那句实况已经把地名念过了，这里只补「今天」，
+             * 别一句里念两遍「北京」。 */
+            if (day == 0) {
+                off = say_cn(output, output_size, off, "%s", word);
+            } else {
+                off = say_cn(output, output_size, off, "%s%s天气", word,
+                             disp[0] ? disp : location);
+            }
+            if (cJSON_IsNumber(jmax)) {
+                off = say_cn(output, output_size, off,
+                             "最高 %.0f 度", jmax->valuedouble);
+            }
+            if (cJSON_IsNumber(jmin)) {
+                off = say_cn(output, output_size, off, "%s最低 %.0f 度",
+                             cJSON_IsNumber(jmax) ? "，" : "", jmin->valuedouble);
+            }
+            if (cJSON_IsNumber(jpop)) {
+                off = say_cn(output, output_size, off,
+                             "，下雨的概率 %d%%", (int)(jpop->valuedouble + 0.5));
+            }
+            off = say_cn(output, output_size, off, "。");
+        }
+    }
+
+    if (off == 0) {
+        goto out;
+    }
+
+    syslog(LOG_INFO, "[%s] Open-Meteo: %s\n", TAG, output);
+    ret = OK;
+
+out:
+    if (root) {
+        cJSON_Delete(root);
+    }
+    free(buf);
+    return ret;
+}
