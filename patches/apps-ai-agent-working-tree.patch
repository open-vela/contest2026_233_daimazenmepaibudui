+ *   返回 0..7 = 第几天；返回 -1 = 该交回大模型（过去的日子 / 说得含糊 /
+ *   一句话里问了不止一天）。
+ * ★ 查的是**整句**不是抠出来的那段 —— 「上海今天天气怎么样？明天呢？」里
+ *   「明天」在尾巴上，抠出来的只有「上海」，只看那段会把明天的问题当今天
+ *   的答掉。既出现「今天/现在」又出现别的日子 = 一句话问了两天，同样退。 */
+static int city_day_offset(const char* text)
+{
+    int day = 0;
+    int seen_other = 0;
+    int seen_now = 0;
+
+    for (int i = 0; s_city_time[i].word; i++) {
+        if (strstr(text, s_city_time[i].word) == NULL) {
+            continue;
+        }
+        if (s_city_time[i].day < 0) {
+            return -1;
+        }
+        if (s_city_time[i].day == 0) {
+            seen_now = 1;
+            continue;
+        }
+        if (seen_other && day != s_city_time[i].day) {
+            return -1;            /* 「明天后天天气」这种，别猜 */
+        }
+        day = s_city_time[i].day;
+        seen_other = 1;
+    }
+    if (seen_other && seen_now) {
+        return -1;
+    }
+    return day;
+}
+
+/* 标点/空白。**按 UTF-8 整字符**匹配，不用 strspn —— strspn 是按字节，
+ * 「，」是 EF BC 8C，会把以 EF 开头的汉字误吃掉。 */
+static const char s_seps[] =
+    " \t\n\r，,。.！!？?、；;：:「」『』“”‘’（(）)《》【】…—-";
+
+static size_t sep_len(const char* s)
+{
+    unsigned char c = (unsigned char)*s;
+    int n = 1;
+    char one[8];
+
+    if (c == 0) {
+        return 0;
+    }
+    if (c >= 0xF0)      n = 4;
+    else if (c >= 0xE0) n = 3;
+    else if (c >= 0xC0) n = 2;
+    if ((int)strlen(s) < n) {
+        n = (int)strlen(s);
+    }
+    memcpy(one, s, n);
+    one[n] = '\0';
+    return strstr(s_seps, one) != NULL ? (size_t)n : 0;
+}
+
+/* 从尾部吃掉标点空白：留到最后一个「非标点」字符为止。 */
+static void city_trim_trailing_seps(char* city)
+{
+    size_t keep = 0;
+    size_t i = 0;
+
+    while (city[i]) {
+        int n = 1;
+        unsigned char c = (unsigned char)city[i];
+
+        if (c >= 0xF0)      n = 4;
+        else if (c >= 0xE0) n = 3;
+        else if (c >= 0xC0) n = 2;
+        if ((int)strlen(city + i) < n) {
+            n = (int)strlen(city + i);
+        }
+        if (sep_len(city + i) == 0) {
+            keep = i + (size_t)n;
+        }
+        i += (size_t)n;
+    }
+    city[keep] = '\0';
+}
+
+/* 把整句里抠出来的那段收成一个像地名的词。
+ * ★ 两头都必须**循环**剥到不动为止：
+ *   · 开头「你好，你好，上海今天」剥掉「你好」剩「，你好，上海今天」——
+ *     不先啃标点就卡住了，后面那个「你好」再也剥不掉（真踩过）。
+ *   · 尾巴「哈尔滨现在这会儿的」剥掉「的」剩「哈尔滨现在这会儿」——
+ *     不循环就吃不掉「这会儿」了（也真踩过）。 */
+static void city_normalize(char* city)
+{
+    int round;
+
+    for (round = 0; round < 24; round++) {
+        int hit = 0;
+        size_t n = sep_len(city);
+
+        if (n > 0) {
+            memmove(city, city + n, strlen(city) - n + 1);
+            hit = 1;
+        }
+        for (int i = 0; s_city_filler[i]; i++) {
+            size_t fl = strlen(s_city_filler[i]);
+            if (strncmp(city, s_city_filler[i], fl) == 0) {
+                memmove(city, city + fl, strlen(city) - fl + 1);
+                hit = 1;
+                break;
+            }
+        }
+        /* 开头的时间词同样要剥：「今天济南」→「济南」、「明天上海」→「上海」。
+         * 只从尾巴剥不够 —— 老人习惯把时间说在城市前面（见 s_city_time 头上）。 */
+        for (int i = 0; s_city_time[i].word; i++) {
+            size_t tl = strlen(s_city_time[i].word);
+            if (strncmp(city, s_city_time[i].word, tl) == 0) {
+                memmove(city, city + tl, strlen(city) - tl + 1);
+                hit = 1;
+                break;
+            }
+        }
+        if (!hit) {
+            break;
+        }
+    }
+
+    for (round = 0; round < 24; round++) {
+        int hit = 0;
+        size_t before = strlen(city);
+
+        city_trim_trailing_seps(city);
+        if (strlen(city) != before) {
+            hit = 1;
+        }
+        for (int i = 0; s_city_tail[i]; i++) {
+            size_t tl = strlen(s_city_tail[i]);
+            size_t cl = strlen(city);
+            if (cl > tl && strcmp(city + cl - tl, s_city_tail[i]) == 0) {
+                city[cl - tl] = '\0';
+                hit = 1;
+                break;
+            }
+        }
+        /* 尾巴上的时间词照旧剥：「上海今天」→「上海」、「济南明后天」→「济南」。
+         * 表是**最长优先**的，所以「明后天」会先于「后天」被啃掉 —— 反过来
+         * 只会剩下个「明」，卡住整条链。 */
+        for (int i = 0; s_city_time[i].word; i++) {
+            size_t tl = strlen(s_city_time[i].word);
+            size_t cl = strlen(city);
+            if (cl > tl && strcmp(city + cl - tl, s_city_time[i].word) == 0) {
+                city[cl - tl] = '\0';
+                hit = 1;
+                break;
+            }
+        }
+        if (!hit) {
+            break;
+        }
+    }
+}
+
+static bool city_looks_valid(const char* city)
+{
+    /* 寒暄/人称/动作/疑问/时间词里的字 + 标点空白。
+     * 见函数头顶那段：这里**宁可错杀**。 */
+    static const char bad[] =
+        "好请帮我您你他她它们想知到道查看看说告诉诉麻烦"
+        "怎么样什呢吗呀哪谁啥吧"
+        "今现明"
+        "，。！？、；：\"'（）()《》【】…— \t\n\r";
+
+    size_t cl = strlen(city);
+    if (cl < 2 || cl > 24) {
+        return false;
+    }
+
+    for (const char* s = city; *s; ) {
+        int n = 1;
+        char one[8];
+        unsigned char c = (unsigned char)*s;
+
+        if (c >= 0xF0)      n = 4;
+        else if (c >= 0xE0) n = 3;
+        else if (c >= 0xC0) n = 2;
+        if ((int)strlen(s) < n) {
+            n = (int)strlen(s);
+        }
+
+        memcpy(one, s, n);
+        one[n] = '\0';
+        if (strstr(bad, one) != NULL) {
+            return false;
+        }
+        s += n;
+    }
+    return true;
+}
