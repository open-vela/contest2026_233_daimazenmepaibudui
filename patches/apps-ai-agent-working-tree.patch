+ * 一层，代价很低，所以留着。
+ *
+ * 为什么是"带超时的 trylock + 拿不到就退化成不串行"，而不是老老实实
+ * pthread_mutex_lock：
+ *   ① 嵌套会自死锁。本构建 CONFIG_PTHREAD_MUTEX_TYPES=y、默认类型是
+ *      PTHREAD_MUTEX_NORMAL（非递归），NuttX 对"同线程再次 lock"是**故意死锁**的
+ *      （libs/libc/pthread/pthread_mutex_timedlock.c 里写着 "is required to
+ *      deadlock for the case of the non-robust NORMAL mutex"）。今天这条路没有
+ *      嵌套（结论见下），但 llm 那条以后很可能变成"工具调用里再发一次 HTTPS"，
+ *      那时同线程重入就是永久卡死一块板子。用 trylock 就永远不会死等：
+ *      拿不到 → 不加锁继续跑。
+ *   ② 等锁必须**有上界**。这把锁覆盖的区间里有 120s 的读超时和 30s 的写超时
+ *      （LLM 流式响应真的会占满），而提醒人声/语音播报这种"说到就到"的路径不能
+ *      被它拖住。所以只等 REQ_LOCK_WAIT_MS 就放弃，退化成并行发 —— 并行是安全的
+ *      （池按 owner 隔离、raw buffer 有锁），只是少了一层保险。
+ *
+ * 嵌套的结论（2026-09-14 顺着调用链查过，不是猜的）：
+ *   vela_https_request() 内部只会走到 pool_acquire / pool_release /
+ *   tls_ctx_connect / tls_write_request / tls_read_response，以及
+ *   http_proxy 的 proxy_open_tunnel() 和 network_manager 的
+ *   network_acquire_resource()。这些都不回调 vela_https_*（http_proxy.c 自己用
+ *   proxy_conn_* 那一套独立实现，不碰这个池子）。上层 llm_chat / llm_chat_tools /
+ *   各 tool / mimo_post 都是"这一次发完再发下一次"的串行写法，没有同线程重入。
+ *   所以当下不会自死锁；保留 trylock 只是为了以后不踩。
+ *
+ * 为什么**不**把 vela_tls_pool_cleanup() 也塞进这把锁：
+ *   ① 正确性不需要。请求在用着的槽位 in_use==true（pool_acquire 里在 s_pool_lock
+ *      下置位，pool_release 里清），cleanup 遇到 in_use 的槽位本来就跳过，所以
+ *      并发 cleanup 不可能 free 掉一个正在被请求使用的槽位；两边改槽位字段又都在
+ *      s_pool_lock 下，不会撕裂。
+ *   ② 反过来代价很实在。mimo_post() 是"先 cleanup 再 request"，如果 cleanup 也要
+ *      抢这把锁，那么语音链路上一次"立刻要出声"的请求就得先等一个正在跑的 LLM
+ *      请求（可能上百秒）放下锁 —— 白白把一个瞬间返回的调用变成长期阻塞。
+ *   ③ owner 隔离之后，cleanup 只动本组的槽位，剩下唯一的交错可能是"同组另一个
+ *      线程刚要 acquire 的槽位被清了"，最坏结果只是多一次握手（pool_acquire
+ *      看到 valid==false 会重连），无害。 */
+#define REQ_LOCK_WAIT_MS 500 /* 等锁上限：短请求够串上，长请求不拖累别人 */
+#define REQ_LOCK_POLL_MS 10
+
+static pthread_mutex_t s_req_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_t s_req_holder; /* 持锁者，只在持锁期间有意义 */
+
+/* 拿到锁返回 true；被别人占着（或自己就是持锁者＝嵌套）返回 false，
+ * 调用者不加锁继续跑，绝不阻塞。 */
+static bool req_lock_try_acquire(void)
+{
+    /* 同线程重入（嵌套）时非递归锁永远拿不到，直接放弃，别白等 REQ_LOCK_WAIT_MS。
+     * s_req_holder 的读没有加锁保护，但最坏结果只是"把别人的持锁误判成自己的
+     * 嵌套 → 不加锁跑"，安全。 */
+    if (pthread_equal(pthread_self(), s_req_holder)) {
+        return false;
+    }
+
+    for (int waited = 0; waited < REQ_LOCK_WAIT_MS; waited += REQ_LOCK_POLL_MS) {
+        if (pthread_mutex_trylock(&s_req_lock) == 0) {
+            s_req_holder = pthread_self();
+            return true;
+        }
+        usleep(REQ_LOCK_POLL_MS * 1000);
+    }
+
+    syslog(LOG_INFO, "[%s] Another HTTPS request is in flight, running without serialization\n",
+        TAG);
+    return false;
+}
+
+static void req_lock_release(bool locked)
+{
+    if (locked) {
+        s_req_holder = (pthread_t)0;
+        pthread_mutex_unlock(&s_req_lock);
+    }
+}
