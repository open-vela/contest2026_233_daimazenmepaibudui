 };
 
+/* 中文时间串（2026-10-22 起；2026-10-23 再修）。
+ *
+ * ★ 为什么必须是**纯口语**，一个字的元指令都不能带
+ *
+ * 这个返回值有两条出口，而且**都不经过大模型**：
+ *   ① agent_loop.c 的关键词快速通道（"几点了"/"什么时间"/"几点钟"…）——
+ *      命中就 tool_registry_execute() 然后把返回串原样 dispatch 给 TTS；
+ *   ② /time 斜杠命令，同样原样念。
+ * 只有走完整 LLM 那一路，才会经过模型转述。
+ *
+ * 2026-10-23 真机现象：用户问时间，听到的是
+ *   「北京时间 2026年10月23日 星期四 19:40:05（UTC+8），UNIX 时间戳…
+ *    回答用户时请用中文口语转述，例如…不要念时间戳或 22:15 这种数字钟。」
+ * —— 数字钟照念，连"请用中文口语转述"这句给模型看的元指令也一起念了出来。
+ * 根因就是输出格式仍带 %02d:%02d:%02d 且夹了元指令。
+ *
+ * 所以这里直接产出**能张口就念**的中文口语；模型那一路拿到它也只会照着说，
+ * 正好就是要的效果。星期用手算：NuttX 的 strftime %A 没有中文 locale，
+ * 会吐 "Thursday"。 */
+
+static const char *const CN_DIGIT[] = {
+    "零", "一", "二", "三", "四", "五", "六", "七", "八", "九", "十"
+};
+
+/* 小时的中文口语（12 小时制），下标 0 对应 12 点 */
+static const char *const CN_HOUR[] = {
+    "十二", "一", "二", "三", "四", "五", "六", "七", "八", "九", "十", "十一"
+};
+
+/* 时段词：按中文口语习惯分段 */
+static const char *cn_period(int hour24)
+{
+    if (hour24 < 6) {
+        return "凌晨";
+    }
+    if (hour24 < 8) {
+        return "早上";
+    }
+    if (hour24 < 12) {
+        return "上午";
+    }
+    if (hour24 < 13) {
+        return "中午";
+    }
+    if (hour24 < 18) {
+        return "下午";
+    }
+    return "晚上";
+}
+
+/* 分钟的中文口语：5 → 零五分，10 → 十分，15 → 十五分，30 → 三十分 */
+static void cn_minute(int m, char *out, size_t out_size)
+{
+    if (m <= 0 || m > 59) {
+        out[0] = '\0';
+        return;
+    }
+
+    if (m < 10) {
+        snprintf(out, out_size, "零%s分", CN_DIGIT[m]);
+    } else if (m < 20) {
+        snprintf(out, out_size, "十%s分", m == 10 ? "" : CN_DIGIT[m - 10]);
+    } else if (m < 30) {
+        snprintf(out, out_size, "二十%s分", m == 20 ? "" : CN_DIGIT[m - 20]);
+    } else if (m < 40) {
+        snprintf(out, out_size, "三十%s分", m == 30 ? "" : CN_DIGIT[m - 30]);
+    } else if (m < 50) {
+        snprintf(out, out_size, "四十%s分", m == 40 ? "" : CN_DIGIT[m - 40]);
+    } else {
+        snprintf(out, out_size, "五十%s分", m == 50 ? "" : CN_DIGIT[m - 50]);
+    }
+}
+
+static void format_time_cn(const struct tm *t, time_t epoch,
+                           char *out, size_t out_size)
+{
+    (void)epoch; /* 时间戳不再输出：念出来毫无意义 */
+
+    static const char *const wd[7] = { "日", "一", "二", "三", "四", "五", "六" };
+
+    char minute[16];
+    cn_minute(t->tm_min, minute, sizeof(minute));
+
+    const char *hour12 = CN_HOUR[(t->tm_hour % 12 == 0) ? 0 : (t->tm_hour % 12)];
+
+    if (minute[0] == '\0') {
+        snprintf(out, out_size, "现在是%s%s点整。今天是%d月%d日，星期%s。",
+            cn_period(t->tm_hour), hour12,
+            t->tm_mon + 1, t->tm_mday, wd[t->tm_wday % 7]);
+    } else {
+        snprintf(out, out_size, "现在是%s%s点%s。今天是%d月%d日，星期%s。",
+            cn_period(t->tm_hour), hour12, minute,
+            t->tm_mon + 1, t->tm_mday, wd[t->tm_wday % 7]);
+    }
+}
+
