+        f = fopen(AGENT_SOUL_FILE, "w");
+        if (!f) {
+            syslog(LOG_ERR, "[%s] Cannot rewrite %s, errno=%d\n", TAG,
+                   AGENT_SOUL_FILE, errno);
+            return;
+        }
+        fwrite(out, 1, (size_t)w, f);
+        fclose(f);
+        syslog(LOG_INFO, "[%s] SOUL.md 旧版语言准则已自愈（英文回复→全程中文）\n", TAG);
+    }
