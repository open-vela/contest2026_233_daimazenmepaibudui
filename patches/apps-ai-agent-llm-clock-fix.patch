+/* ── Monotonic clock for latency measurement ─────────────
+ *
+ * 计时一律用单调时钟：不受 RTC_SET_TIME / NTP / `date -s` 改墙钟影响。
+ *
+ * 背景（真机踩过，现象很吓人）：vela_tls.c 在 TLS 握手时若发现板子时钟太旧，
+ * 会把 CLOCK_REALTIME 硬跳到 2026。如果这里用墙钟算耗时，请求进行中的这次跳变
+ * 会让 sec_diff 变成 8.26e8 秒，再乘 1000 就在 32 位上回绕成 955862003 ms，
+ * watchdog 于是把已经收到的回复判成超时丢掉。
+ * ───────────────────────────────────────────────────────────── */
+static inline void mono_gettimeofday(struct timeval* tv)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    tv->tv_sec  = (time_t)ts.tv_sec;
+    tv->tv_usec = (suseconds_t)(ts.tv_nsec / 1000);
+}
+
 /* ── Clock-safe elapsed time calculation ───────────────────── */
 
+
 static inline uint32_t calc_elapsed_ms(const struct timeval* t0,
     const struct timeval* t1)
 {
@@ -89,6 +108,15 @@ static inline uint32_t calc_elapsed_ms(const struct timeval* t0,
         return 0;
     }
 
+    /* 往前跳了不合理的大跨度（改墙钟 / 时钟异常）：钳到上限。
+     * 否则下面乘 1000 会在 32 位上回绕，把一个荒谬的 latency 写进 router
+     * 统计，还会让 watchdog 误判超时。约 49 天以内乘 1000 不会溢出 uint32。 */
+    if (sec_diff > 4294967) {
+        syslog(LOG_WARNING, "[%s] Clock jumped forward %lds, clamping\n",
+               TAG, (long)sec_diff);
+        return 0xFFFFFFFFu;
+    }
+
     return (uint32_t)sec_diff * 1000 + (uint32_t)usec_diff / 1000;
 }
 
