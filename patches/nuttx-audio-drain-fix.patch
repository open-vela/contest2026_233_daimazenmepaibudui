+      /* ★ 被抢的那个 fd 的 priv->state 还停在 RUNNING，必须一并作废
+       * （2026-10-26）。上面这句 lower->ops->stop() 绕过了 audio_stop()，
+       * 而 priv->state = OPEN 只写在 audio_stop() 里 —— 会话被拆了、记账
+       * 却没清，于是它永久举着"我有活会话"，之后**所有** audio_stop() 的
+       * 放行判据（audio_getnstate() <= PREPARED）恒假，硬件永远停不下来、
+       * 永远没人发 COMPLETE，状态机钉死，CONFIGURE/START 全被静默吞掉。
+       * 触发点恰好是第一句回复起播（OUTPUT 抢 INPUT），真机症状就是
+       * 「回了一句就再也不说话」。 */
+
+      audio_forget_sessions(upper, priv, "半双工抢占拆掉了别人的会话");
+    }
+
+  /* 转发门（2026-10-21 放宽到 PREPARED）：
+   *
+   * 原来只在 OPEN（或抢占后、或非 INPUT/OUTPUT 类型）转发，于是
+   * "CONFIGURE 过了、还没 START"的 PREPARED 态会把后续 CONFIGURE **静默吞掉**
+   * （返回 OK、驱动毫不知情）。半双工抢占之后这道门是致命的：抢占把状态显式
+   * 落到 PREPARED，接着录音侧重启的 CONFIGURE(INPUT) 正好撞上这道门被吞掉 ——
+   * 驱动看到的 pending_playback 还是那次抢占留下的 true，录音会话带着
+   * playback=1 的标签启动（串口铁证 "hw_start 真跑了：playback=1"），
+   * L5 恢复守卫看着"健康的播放"永久跳过、RX 冻死。
+   *
+   * PREPARED 的语义就是"配好了、还没起"——在这个状态重配一次是**合法**的
+   * （换方向、换采样率都要走这条路），转发它没有任何"改正在跑的会话"的风险：
+   * 真正在跑是 RUNNING/PAUSED，那两个仍然被这道门挡着。 */
+
   if (upper->status->state == AUDIO_STATE_OPEN ||
+      upper->status->state == AUDIO_STATE_PREPARED ||
+      preempted ||
       (caps->ac_type != AUDIO_TYPE_INPUT &&
        caps->ac_type != AUDIO_TYPE_OUTPUT))
     {
@@ -501,9 +616,24 @@ static int audio_configure(FAR struct file *filep,
       upper->info.samplerate =
           caps->ac_controls.hw[0] | (caps->ac_controls.b[3] << 16);
       memcpy(&upper->info.codec, &caps->ac_codec, sizeof(caps->ac_codec));
+
+      /* 只有**真的转发给了驱动**才配记账成本 fd "配好了、还没起"
+       * （2026-10-26）。原来这句挂在 if 外面，被门吞掉的 CONFIGURE 也会把
+       * priv->state 改掉：轻则把一个正在跑的 fd 从 RUNNING 降级成 PREPARED
