+    uint16_t txpkr = (privep->epphy == 0) ? USB_CSR0_TXPKTRDY
+                                          : USB_TXCSR_TXPKTRDY;
+    hw->index = privep->epphy;
+    if (hw->csr0_txcsr & txpkr)
+      {
+        usbtrace(TRACE_WRITE(privep->epphy), privreq->req.xfrd);
+        return OK;
+      }
+  }
