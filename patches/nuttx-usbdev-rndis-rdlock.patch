 static void rndis_cancel_rdreq(FAR struct rndis_dev_s *priv)
 {
+  irqstate_t flags = spin_lock_irqsave(&priv->rdlock);
+
   if (priv->rdreq_submitted)
     {
-      EP_CANCEL(priv->epbulkout, priv->rdreq);
+      /* Clear the flag under the lock, then cancel outside it: EP_CANCEL
+       * on this vendor UDC may run a nested completion callback, which
+       * takes the same lock.  While rx_blocked is set (the only condition
+       * under which cancel is called) no other site can claim the flag. */
+
       priv->rdreq_submitted = false;
+      spin_unlock_irqrestore(&priv->rdlock, flags);
+      EP_CANCEL(priv->epbulkout, priv->rdreq);
+      return;
     }
+
+  spin_unlock_irqrestore(&priv->rdlock, flags);
