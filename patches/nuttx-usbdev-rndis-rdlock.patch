+  irqstate_t flags;
   int ret = OK;
 
+  /* 2026-10-12 真机定案（第二次）：本函数有两个并发调用点 ——
+   * rxdispatch 尾部（ETHWORK worker，CPU-B）和 freewrreq（bulk IN 写完成
+   * 回调，IRQ 上下文，CPU-A）。两边原来都是裸读 rdreq_submitted 做
+   * 检查-然后-动作，SMP 上会双双通过检查、把同一个 rdreq EP_SUBMIT 两次
+   * —— 厂商 UDC 的 bulk OUT 队列就此损坏：驱动以为请求还在途、endpoint
+   * 队列其实已空，RX 永久死亡（板子静默、主机 transmit queue watchdog）。
+   * 对话重流量（ASR 上传 + TTS 下载同时打满双向）时必现。
+   *
+   * 修法：标志检查+占位在 rdlock 里做（关中断自旋锁），EP_SUBMIT 放在
+   * 锁外 —— UDC 允许同步完成，嵌套的完成回调会再进 cancel/block 路径取
+   * 同一把锁，锁内调 EP_SUBMIT 会死锁。占位后只有本调用者会提交，
+   * 另一调用点看到 rdreq_submitted=true 直接返回。
+   */
+
+  flags = spin_lock_irqsave(&priv->rdlock);
