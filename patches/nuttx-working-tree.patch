--- a/net/tcp/tcp_timer.c
+++ b/net/tcp/tcp_timer.c
@@ -516,6 +516,28 @@ void tcp_timer(FAR struct net_driver_s *dev, FAR struct tcp_conn_s *conn)
           tcp_callback(dev, conn, TCP_TIMEDOUT);
 
           ninfo("TCP state: TCP_CLOSED\n");
+
+          /* ★ 2026-11-02：**TIME_WAIT 到期后必须把连接还回 mempool**。
+           *
+           *   真机取证（20:44，3 分钟）：nalloc 6→29，其中 21 条停在
+           *   TCP_CLOSED、crefs=0、对端端口 0，而且每次 HTTPS 连接关闭
+           *   就多一条。成因链：
+           *     ① close() 后 tcp_close_work 先置 TCP_CLOSE_DIRECT；
+           *     ② 它执行时状态还是 FIN_WAIT_2 → “state==CLOSED” 不成立，
+           *        跳过 tcp_free，之后**没有任何人再回调它**；
+           *     ③ 2MSL 后本分支把状态置 CLOSED、调用 tcp_callback，
+           *        但 close 回调在 ① 的 end_wait 里已经释放，没人接；
+           *     ④ 条目从此挂在 active 链表上，直到 128 条 socket() ENOMEM。
+           *   这里补上最后一步：无引用且 close work 已经跑过（DIRECT）
+           *   就直接 free。与 SYN_RCVD 超时分支的写法一致（先解锁再 free）。 */
+
+          if (conn->crefs == 0 &&
+              (conn->flags & TCP_CLOSE_DIRECT) != 0)
+            {
+              conn_unlock(&conn->sconn);
+              tcp_free(conn);
+              return;
+            }
         }
       else
         {
