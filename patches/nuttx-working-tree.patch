+/****************************************************************************
+ * Name: audio_forget_sessions
+ *
+ * Description:
+ *   把其它 fd 身上"我手里有活会话"的记账清回 OPEN，可选地打一行告警。
+ *
+ *   专供**半双工抢占**那条路用。抢占是直调 lower->ops->stop() 拆掉正在跑的
+ *   那个会话（见 audio_configure 里的说明），**绕过了 audio_stop()** —— 而
+ *   priv->state = OPEN 那句只写在 audio_stop() 里。于是被抢的那个 fd 从此
+ *   永久举着 RUNNING，而 audio_stop() 的放行判据恰好是
+ *   "audio_getnstate() <= PREPARED"（见下），它一个人就能把**所有** STOP
+ *   挡在门外：硬件停不下来、COMPLETE 永远不发、上层状态机顶在 RUNNING，
+ *   往后每一次 CONFIGURE/START 都被那道门静默吞掉却照样返回 OK。
+ *
+ *   真机指纹（2026-10-26）：串口 "AUDIO_IN: started" 打了 22 次、
+ *   "hw_start 真跑了" 一次都没有，armed=0 busy=0，监听守护每 5 秒
+ *   "判定僵尸会话" 重开一圈，麦克风永久失聪 —— 而触发点正是第一句回复
+ *   起播时 OUTPUT 抢 INPUT 那一下。
+ *
+ * Input Parameters:
+ *   upper  - 上半部
+ *   cur    - 本次调用者自己的会话（不清它：它马上要接着起，状态由它自己写）
+ *   why    - 触发原因，只用来打日志；NULL 表示静默
+ *
+ ****************************************************************************/
+
+static void audio_forget_sessions(FAR struct audio_upperhalf_s *upper,
+                                  FAR struct audio_openpriv_s *cur,
+                                  FAR const char *why)
+{
+  FAR struct audio_openpriv_s *priv;
+  int cleared = 0;
+  irqstate_t flags;
+
+  flags = spin_lock_irqsave(&upper->spinlock);
+  for (priv = upper->head; priv != NULL; priv = priv->flink)
+    {
+      if (priv != cur && priv->state > AUDIO_STATE_PREPARED)
+        {
+          priv->state = AUDIO_STATE_OPEN;
+          cleared++;
+        }
+    }
+
+  spin_unlock_irqrestore(&upper->spinlock, flags);
+
+  if (cleared > 0)
+    {
+      syslog(LOG_WARNING,
+             "audio: 清掉 %d 个陈旧的会话记账（%s）—— 不清的话它们会把所有 "
+             "STOP 永久挡在门外\n",
+             cleared, why != NULL ? why : "?");
+    }
+}
