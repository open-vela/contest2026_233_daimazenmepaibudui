+#define TCP_CONN_PROBE_NPEER    8    /* 最多列 8 个不同的对端端口 */
+
+struct tcp_conn_probe_peer_s
+{
+  uint16_t rport;   /* network byte order */
+  uint16_t count;
+};
+
+struct tcp_conn_probe_s
+{
+  int      used;                              /* g_tcp_connections.nalloc */
+  int      cap;                               /* maxalloc（0 = 不限） */
+  int      nactive;                           /* g_active_tcp_connections 长度，-1 = 这拍没拿到锁 */
+  int      nstate[TCP_CONN_PROBE_NSTATE];     /* 按 TCP_STATE_MASK 计数 */
+  int      npeer;
+  struct tcp_conn_probe_peer_s peer[TCP_CONN_PROBE_NPEER];
+};
+
+void tcp_conn_probe(FAR struct tcp_conn_probe_s *out);
