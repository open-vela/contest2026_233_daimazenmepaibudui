+/****************************************************************************
+ * Name: tcp_conn_probe
+ *
+ * Description:
+ *   只读快照：连接池用了多少、活动连接各处于什么 TCP 状态、对端端口分布。
+ *   纯仪表，不改任何状态；给应用侧的状态信标用（见
+ *   app/hello_app/ai_companion_main.c 的 state_beacon_task）。
+ *
+ *   为什么要它：g_tcp_connections 是个 mempool，mempool_allocate() 在
+ *   nalloc >= maxalloc 时**先于空闲队列**就返回 NULL，于是 socket() 直接
+ *   ENOMEM。到那一步时"哪条连接没被还回来"完全看不出来，只能猜。这一行
+ *   把它变成一条判据：
+ *     - nstate 里 TIME_WAIT 占绝大多数  => 是收尾没跑完（close 后 FIN/TIME_WAIT
+ *       把 tcp_conn_s 又占了 CONFIG_NET_TCP_WAIT_TIMEOUT 秒），不是泄漏；
+ *     - ESTABLISHED / SYN_SENT 占着且长期不掉 => 是真泄漏，看 peer 表里对端
+ *       端口就知道是哪条链路（443=HTTPS、1883=MQTT、5600=LCDMIRROR、…）。
+ *
+ *   用 nxrmutex_trylock 而不是 tcp_conn_list_lock()：信标的铁律是"绝不阻塞"，
+ *   拿不到锁就把明细跳过（nactive = -1），池子计数仍然照报（无锁读两个
+ *   size_t，仪表精度足够）。
+ *
+ ****************************************************************************/
+
+void tcp_conn_probe(FAR struct tcp_conn_probe_s *out)
+{
+  FAR struct tcp_conn_s *tmp;
+
+  if (out == NULL)
+    {
+      return;
+    }
+
+  memset(out, 0, sizeof(*out));
+
+  /* 这两个是 mempool 里的计数器，加减都在锁内完成；无锁读对仪表来说够了。 */
+
+  out->used = (int)g_tcp_connections.nalloc;
+  out->cap  = (int)g_tcp_connections.maxalloc;
+
+  if (nxrmutex_trylock(&g_tcp_connections_lock) != OK)
+    {
+      out->nactive = -1;
+      return;
+    }
+
+  for (tmp = (FAR struct tcp_conn_s *)g_active_tcp_connections.head;
+       tmp != NULL;
+       tmp = (FAR struct tcp_conn_s *)tmp->sconn.s_node.flink)
+    {
+      int st = tmp->tcpstateflags & TCP_STATE_MASK;
+      int i;
+
+      out->nactive++;
+
+      if (st >= 0 && st < TCP_CONN_PROBE_NSTATE)
+        {
+          out->nstate[st]++;
+        }
+
+      /* 对端端口归并计数：443=HTTPS、1883=MQTT、5600=LCDMIRROR……
+       * 比逐条列连接紧凑得多，一行就能看出"是谁在刷连接"。 */
+
+      for (i = 0; i < out->npeer; i++)
+        {
+          if (out->peer[i].rport == tmp->rport)
+            {
+              out->peer[i].count++;
+              break;
+            }
+        }
+
+      if (i == out->npeer && out->npeer < TCP_CONN_PROBE_NPEER)
+        {
+          out->peer[out->npeer].rport = tmp->rport;
+          out->peer[out->npeer].count = 1;
+          out->npeer++;
+        }
+    }
+
+  nxrmutex_unlock(&g_tcp_connections_lock);
+}
