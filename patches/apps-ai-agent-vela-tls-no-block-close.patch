 static void tls_ctx_free(tls_ctx_t* ctx)
 {
-    mbedtls_ssl_close_notify(&ctx->ssl);
+    /* ★ 不要发 close_notify（2026-09-14 实测卡死根因）。
+     *
+     * mbedtls_ssl_close_notify() 内部是 mbedtls_ssl_flush_output() → mbedtls_net_send()
+     * → write()，**一次阻塞的 TCP 发送**；而本文件的 socket 只在
+     * CONFIG_AI_AGENT_NET_RPMSG 下才设 SO_SNDTIMEO（我们这版没开），所以对端已经
+     * 不在了的时候它就是死等 TCP 重传超时（分钟级）。实测栈：
+     *   mimo_asr_recognize → vela_tls_pool_cleanup → tls_ctx_free
+     *     → mbedtls_ssl_flush_output → mbedtls_net_send → psock_tcp_send（卡住）
+     * 现象就是"语音识别永远停在处理中、连握手日志都打不出来"。
+     *
+     * 池子里这些都是**要丢掉的旧连接**，本地直接拆掉就行：服务端收到 FIN/RST
+     * 自己会回收，keep-alive 池子里也不再留它。 */
     mbedtls_net_free(&ctx->net);
     mbedtls_ssl_free(&ctx->ssl);
     mbedtls_ssl_config_free(&ctx->cfg);
@@ -306,6 +317,17 @@
 #endif
