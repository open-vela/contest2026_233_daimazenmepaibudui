+/* ==================== 面板 QSPI 写时钟（降频 / 一键回退） ====================
+ * 这个 freq 不是面板自己的刷新率（CO5300 带 GRAM，自刷新由它内部振荡器驱动），
+ * 而是 SoC 往面板推像素的那条 QSPI 总线的时钟。它是全驱动里唯一的来源：
+ * HAL_LCDC_Init() → SetFreq() 拿它算分频写进 SPI_IF_CONF.CLK_DIV，读寄存器时
+ * 的降速/恢复（LCD_ReadMode）用的也是同一个值。
+ *
+ *     CLK_DIV = ceil(HCLK / freq)   （HAL 里那个除法向上取整，硬件最小分频 2）
+ *     面板时钟 = HCLK / CLK_DIV
+ *
+ * 本板 HCLK = 240MHz（bsp_init.c 的 HAL_RCC_HCPU_EnableDLL1(240000000)）：
+ *     50000000（CO5300 手册上限，改前）→ CLK_DIV = 5  → 面板时钟 48MHz
+ *     24000000（现在）               → CLK_DIV = 10 → 面板时钟 24MHz
+ *
+ * 为什么降：本板 USB 直供（不带电池），厂商提交 0a3cd0a 自己写着 "some panels
+ * do not respond reliably to ID queries on USB-only power where read timing is
+ * marginal" —— 48MHz 下这条总线在 USB 供电时处于边缘时序，症状是间歇性丢像素
+ * （大块背景丢、只剩细笔画，偶尔整屏黑），而应用/LCDC 侧一切正常。
+ *
+ * 代价：推送带宽减半（4 数据线 24MHz ≈ 12MB/s，全屏 390×450×2B ≈ 29ms/帧）；
+ * 面板自刷新不受影响，只有"往面板推画面"变慢。
+ *
+ * SF32LB_LCD_QSPI_CLK_SLOW 置 0 ⇒ 走下面 #else 分支，逐字回到改前的字面值
+ * 50000000（= 48MHz）。
+ */
+#define SF32LB_LCD_QSPI_CLK_SLOW 1
+
+#if SF32LB_LCD_QSPI_CLK_SLOW
+#define SF32LB_LCD_QSPI_CLK_HZ   24000000
+#endif
+
 static LCDC_InitTypeDef lcdc_int_cfg_qadspi =
 {
     .lcd_itf = QAD_SPI_ITF, // LCDC_INTF_SPI_NODCX_1DATA
 #if defined(LCD_MAX_CLK_FREQ)
     .freq = LCD_MAX_CLK_FREQ,        //CO5300 RGB565 only support 50000000,  RGB888 support 60000000
+#elif SF32LB_LCD_QSPI_CLK_SLOW
+    .freq = SF32LB_LCD_QSPI_CLK_HZ,  //24000000 -> CLK_DIV 10 -> 24MHz @HCLK 240MHz
 #else
     .freq = 50000000, //CO5300 RGB565 only support 50000000,  RGB888 support 60000000
 #endif
