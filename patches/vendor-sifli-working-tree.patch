+/****************************************************************************
+ * Name:  sf32lb_lcd_panel_lock_timeout
+ *
+ * Description:
+ *   带超时地拿 panel_lock。返回 0 拿到、-1 超时（调用方自己决定：
+ *   重初始化是"从坏状态里往外捞"，超时也要继续；setpower 超时则照原样下发）。
+ *
+ *   为什么要带超时：一次面板复位会把锁按住 ~0.4 秒，而调用方可能是
+ *   "用户刚点了什么就要立刻生效"的路径。sem_wait 万一遇到没人释放的锁
+ *   就是永久卡死一块板子，这里给上界。
+ *
+ ****************************************************************************/
+
+static int sf32lb_lcd_panel_lock_timeout(uint32_t ms)
+{
+  struct timespec ts;
+
+  clock_gettime(CLOCK_REALTIME, &ts);
+  ts.tv_sec  += (time_t)(ms / 1000u);
+  ts.tv_nsec += (long)(ms % 1000u) * 1000000L;
+  if (ts.tv_nsec >= 1000000000L)
+    {
+      ts.tv_sec  += 1;
+      ts.tv_nsec -= 1000000000L;
+    }
+
+  while (sem_timedwait(&s_drv_lcd.panel_lock, &ts) < 0)
+    {
+      if (errno != EINTR)
+        {
+          return -1;
+        }
+    }
+
+  return 0;
+}
