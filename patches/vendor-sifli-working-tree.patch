+/****************************************************************************
+ * Name:  sf32lb_lcd_panel_reinit
+ *
+ * Description:
+ *   面板重新初始化 —— 把"面板丢了配置"造成的整屏黑救回来的入口
+ *   （复位不生效、只有真断电才好的那种黑，见 docs/display_touch_gpio_usage.md
+ *   第 3.4 节）。
+ *
+ *   做的事，就是开机那条路重走一遍（顺序也一样），但**每一步都打一行日志**：
+ *     STEP1  拿 panel_lock（挡住 putrun / putarea / setpower）
+ *     STEP2  进来时的状态快照：LCDC 的 State/Lock/ErrorCode/收发计数、四个关键
+ *            寄存器、显示时钟（HCLK + SPI_IF_CONF.CLK_DIV ⇒ 面板时钟）
+ *     STEP3  **动手之前先读一次面板 ID**（全流程最有判别力的一步，见下）
+ *     STEP4  坏状态归零：Lock→UNLOCKED、State→READY、ErrorCode→NONE
+ *     STEP5  BSP_LCD_PowerUp()：VADD_EN(PA37) 拉高 + LCD 那几根脚重新 pinmux
+ *     STEP6  自己拉一轮 RESET 脚，低电平比开机长（30ms vs 10ms）
+ *     STEP7  p_ops->Init()：**内含 HAL_LCDC_Init()** —— RCC_MOD_LCDC1 整模块
+ *            复位 → 接口选择/时钟分频/输出格式/TE/接口使能/释放 RSTB，随后拉
+ *            RESET 脚 + 重发整串面板寄存器（0xFE 页切换、密码锁、SPI 模式、0x3A
+ *            像素格式、0x2A/0x2B 窗口、0x11 出睡眠、0x29 DisplayOn）
+ *     STEP8  补开机那一步中断接线：irq_attach + up_enable_irq(LCDC1)（幂等）
+ *     STEP9  sf32lb_lcd_lcdc_setup()：LCDC 侧背景色/层复位/层像素格式；再按当前
+ *            bpp 显式设一次像素格式（SetColorMode）
+ *     STEP10 亮度按驱动里记着的值重下发（面板复位后 WBRIGHT 会回默认值），
+ *            再清 power 后 DisplayOn 一次，让 priv->power 和面板对齐
+ *     STEP11 收工后再读一次面板 ID
+ *     STEP12 结论 + 耗时/持锁时间（直接回答"挡了刷屏多久"）
+ *
+ *   === 怎么用日志判断卡在哪一层（STEP3 / STEP11 的 ReadID）===
+ *   面板 ID 是"QSPI 链路 + LCDC 出位 + 面板本身"同时活着的最好证据：
+ *     - 读回 == p_drv_ops->id（本板 0x331100）⇒ 送得出去也读得回来，问题不在
+ *       面板通路；去看 LCDC 出帧那一侧（层/格式/背景色）、面板自己的显示开关
+ *       （0x29/0x28）、亮度（0x51）、或者背光 PWM。
+ *     - 读不回（0 / 0xFFFFFF）⇒ QSPI 或面板那侧：LCDC 的 SPI 时钟分频/模块复位
+ *       没起来、State 卡在 BUSY（HAL_LCDC_ReadDatas 会直接返回 HAL_BUSY）、
+ *       RESET 脚没释放、VADD_EN(PA37) 没供上。
+ *   再配上 STEP2 的 State/Lock/寄存器快照，"哪一层卡住"就钉死了。
+ *
+ *   === 为什么不再单独调 HAL_LCDC_Reset() ===
+ *   读实现（bf0_hal_lcdc.c:2373）可以确认 HAL_LCDC_Reset() 就是
+ *   `LCDC_HW_Init(lcdc)` + `State = READY`，和 HAL_LCDC_Init() 的唯一区别是后者
+ *   还顺手置了一下 Layer[].disable；而 **LCDC_HW_Init() 每次都会
+ *   `HAL_RCC_EnableModule + HAL_RCC_ResetModule(RCC_MOD_LCDC1)`** —— 那一步就是
+ *   LCDC 整个模块的硬复位，正是"显示通路重来一遍"要的东西。两条都能重入也不是
+ *   靠猜：开机路径已经把 p_ops->Init()（= 内含 HAL_LCDC_Init）整整调了三次
+ *   （find_right_driver、lcd_init_thread_entry、lcd_hw_setup_thread_entry）。
+ *   既然 Init() 已经做了同样的模块复位，再插一次 HAL_LCDC_Reset() 只是多一次
+ *   全模块复位、多一个 ROM 函数的重入面，什么也不多给 —— 所以不加。
+ *   （要确认它真做了，看 STEP2 与 STEP7 之后那几行寄存器/时钟日志。）
+ *
+ *   === 显示时钟 / PMU 电源域 ===
+ *   LCDC1 的模块时钟来自 HCLK（本板 240MHz、由 bsp_init.c 的 DLL1 提供），分频写
+ *   进 SPI_IF_CONF.CLK_DIV，**没有独立的显示 PLL，也没有 PMU 里的显示电源域**要
+ *   开。面板的 VADD_EN 是板级 GPIO PA37，由 BSP_LCD_PowerUp() 拉（STEP5）。
+ *   所以 STEP2/STEP7 把 HCLK 和 CLK_DIV 都打出来，一眼看出时钟对不对。
+ *   （LCDC 那个 SPI/四线接口就是面板总线，**不是** flash 的 SFC 控制器，别去动 SFC。）
+ *
+ *   === 和"正在刷屏的 LVGL 线程"共存 ===
+ *   整个 STEP2~STEP11 都拿 s_drv_lcd.panel_lock，而 putrun/putarea 推像素、
+ *   setpower、以及开机那次面板复位拿的是同一把锁 —— 所以"重发配置"和"推一帧像素"
+ *   不会同时在 QSPI 上跑。代价是这段时间刷新会卡住（面板本来就在复位，卡住是应该
+ *   的）；STEP12 会把实际持锁时长打出来。更彻底的做法是"先让 LVGL 停刷再重初始
+ *   化"（LVGL 的刷新由它自己的定时器驱动，本项目没有现成的暂停接口），本轮没做，
+ *   影响见文档 3.4 节。
+ *
+ *   **只动面板和 LCDC，不碰 LVGL**：屏幕重绘由调用方负责
+ *   （robot_ui 的 robot_ui_bridge_panel_reinit() 会往 LVGL 线程投一次全屏失效）。
+ *
+ *   Returned Value:
+ *     OK       重新初始化下发完成
+ *     -ENODEV  面板驱动还没绑上（开机 lcd_init 线程还没跑到）
+ *     -EINVAL  在中断上下文里调的
+ *     -ENOSYS  编译期关掉了（SF32LB_LCD_PANEL_REINIT = 0）
+ *
+ ****************************************************************************/
+
+/****************************************************************************
+ * 重初始化用的两个小工具
+ ****************************************************************************/
+
+#if SF32LB_LCD_PANEL_REINIT
+
+/* 单调毫秒计时。用它量"持锁多久"，直接把"挡了刷屏多长时间"变成日志上的一行。 */
+static uint32_t sf32lb_lcd_now_ms(void)
+{
+  struct timespec ts;
+
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return (uint32_t)((uint64_t)ts.tv_sec * 1000u
+                    + (uint64_t)ts.tv_nsec / 1000000u);
+}
+
+/* 读面板 ID（走面板驱动的 ReadID 回调，本板 = CO5300 的 0x04 寄存器）。
+ * 没实现 ReadID 时回 0xffffffff，调用方按"读不到"处理。 */
+static uint32_t sf32lb_lcd_read_panel_id(FAR lcd_drv_desc_t *p_drv_ops)
+{
+  if (p_drv_ops == NULL || p_drv_ops->p_ops == NULL ||
+      p_drv_ops->p_ops->ReadID == NULL)
+    {
+      return 0xffffffffu;
+    }
+
+  return p_drv_ops->p_ops->ReadID(&s_drv_lcd.hlcdc);
+}
+
+#endif /* SF32LB_LCD_PANEL_REINIT */
+
+int sf32lb_lcd_panel_reinit(void)
+{
+#if !SF32LB_LCD_PANEL_REINIT
+  LCD_REINIT_WARN("sf32lb_lcd_panel_reinit: 编译期已关闭（SF32LB_LCD_PANEL_REINIT=0）");
+  return -ENOSYS;
+#else
+  lcd_drv_desc_t *p_drv_ops = s_drv_lcd.p_drv_ops;
+  LCDC_HandleTypeDef *hlcdc = &s_drv_lcd.hlcdc;
+  LCD_IF_TypeDef *regs;
+  uint32_t id_before;
+  uint32_t id_after;
+  uint32_t hclk_mhz;
+  uint32_t clk_div;
+  uint32_t t_enter;
+  uint32_t t_locked;
+  uint32_t t_done;
+
+  if (p_drv_ops == NULL || p_drv_ops->p_ops == NULL ||
+      p_drv_ops->p_ops->Init == NULL)
+    {
+      LCD_REINIT_FAIL("面板驱动还没绑上，先等开机 lcd_init 线程跑完");
+      return -ENODEV;
+    }
+
+  if (up_interrupt_context())
+    {
+      LCD_REINIT_FAIL("不能在中断上下文里调");
+      return -EINVAL;
+    }
+
+  t_enter = sf32lb_lcd_now_ms();
+
+  LCD_REINIT_STEP("===== 开始 (面板 %s bpp %d power %d 亮度 %d%%) =====",
+                  p_drv_ops->name, s_drv_lcd.bpp, s_drv_lcd.power,
+                  s_drv_lcd.contrast);
+
+  /* STEP1：等"面板空闲"。LVGL 20~30 帧/s 地推像素，这里可能真要等一会儿。 */
+  if (SF32LB_LCD_PANEL_LOCK_WAIT(SF32LB_LCD_PANEL_LOCK_WAIT_MS) < 0)
+    {
+      LCD_REINIT_WARN("STEP1 等 panel_lock 超时 %dms（推屏太密？）——继续",
+                      SF32LB_LCD_PANEL_LOCK_WAIT_MS);
+    }
+
+  t_locked = sf32lb_lcd_now_ms();
+  LCD_REINIT_STEP("STEP1 拿到面板锁（等了 %u ms），之后刷屏会被挡住",
+                  (unsigned)(t_locked - t_enter));
+
+  regs = hlcdc->Instance;
+
+  /* STEP2：状态快照 —— "动手之前长什么样"的唯一记录。 */
+  LCD_REINIT_STEP("STEP2 LCDC: State=%d Lock=%d ErrorCode=0x%08x 起帧=%u 完帧=%u",
+                  (int)hlcdc->State, (int)hlcdc->Lock,
+                  (unsigned)hlcdc->ErrorCode,
+                  (unsigned)hlcdc->debug_cnt0, (unsigned)hlcdc->debug_cnt2);
+  LCD_REINIT_STEP("STEP2 寄存器: LCD_CONF=0x%08x SPI_IF_CONF=0x%08x LCD_IF_CONF=0x%08x",
+                  (unsigned)regs->LCD_CONF, (unsigned)regs->SPI_IF_CONF,
+                  (unsigned)regs->LCD_IF_CONF);
+  LCD_REINIT_STEP("STEP2 寄存器: TE_CONF=0x%08x STATUS=0x%08x LCD_SINGLE=0x%08x",
+                  (unsigned)regs->TE_CONF, (unsigned)regs->STATUS,
+                  (unsigned)regs->LCD_SINGLE);
+
+  hclk_mhz = HAL_RCC_GetHCLKFreq(CORE_ID_HCPU) / 1000000u;
+  clk_div  = (regs->SPI_IF_CONF & LCD_IF_SPI_IF_CONF_CLK_DIV_Msk)
+             >> LCD_IF_SPI_IF_CONF_CLK_DIV_Pos;
+  LCD_REINIT_STEP("STEP2 显示时钟: HCLK=%uMHz CLK_DIV=%u ⇒ 面板时钟≈%uMHz",
+                  (unsigned)hclk_mhz, (unsigned)clk_div,
+                  (unsigned)(clk_div != 0u ? hclk_mhz / clk_div : 0u));
+
+  /* STEP3：**动手之前**读一次面板 ID —— 全流程最有判别力的一条。 */
+  id_before = sf32lb_lcd_read_panel_id(p_drv_ops);
+  if (id_before == p_drv_ops->id)
+    {
+      LCD_REINIT_PASS("STEP3 读回面板 ID=0x%08x (期望 0x%08x) ⇒ QSPI 链路和面板都活着",
+                      (unsigned)id_before, (unsigned)p_drv_ops->id);
+    }
+  else
+    {
+      LCD_REINIT_WARN("STEP3 读回面板 ID=0x%08x (期望 0x%08x) ⇒ QSPI/面板那侧有问题",
+                      (unsigned)id_before, (unsigned)p_drv_ops->id);
+      if (hlcdc->State != HAL_LCDC_STATE_READY || hlcdc->Lock != HAL_UNLOCKED)
+        {
+          LCD_REINIT_WARN("STEP3 注意 State=%d Lock=%d：读寄存器走 HAL_LCDC_ReadDatas，"
+                          "State!=READY 时它直接回 HAL_BUSY，读失败未必是 QSPI 坏",
+                          (int)hlcdc->State, (int)hlcdc->Lock);
+        }
+    }
+
+  /* STEP4：把上一次留下的坏状态归零。 */
+  if (hlcdc->Lock != HAL_UNLOCKED)
+    {
+      LCD_REINIT_WARN("STEP4 Lock 残留=%d ⇒ 强置 UNLOCKED（否则 WriteDatas 里会死等）",
+                      (int)hlcdc->Lock);
+      hlcdc->Lock = HAL_UNLOCKED;
+    }
+  else
+    {
+      LCD_REINIT_PASS("STEP4 Lock 干净 (HAL_UNLOCKED)");
+    }
+
+  if (hlcdc->State != HAL_LCDC_STATE_READY)
+    {
+      /* HAL_LCDC_ReadDatas / WriteDatas / SendLayerData2Reg_IT 开头都会判
+       * `HAL_LCDC_STATE_READY != lcdc->State` 然后直接返回 HAL_BUSY —— State
+       * 卡在 BUSY 时**每一次寄存器写都静默失败**，正好是整屏黑的形状。
+       * State 只是软件标志，强置 READY 没有硬件副作用（Init 自己也会置回 READY）。 */
+      LCD_REINIT_WARN("STEP4 State=%d 不是 READY ⇒ 强置 READY（否则寄存器读写全 HAL_BUSY）",
+                      (int)hlcdc->State);
+      hlcdc->State = HAL_LCDC_STATE_READY;
+    }
+  else
+    {
+      LCD_REINIT_PASS("STEP4 State=READY");
+    }
+
+  if (hlcdc->ErrorCode != HAL_LCDC_ERROR_NONE)
+    {
+      LCD_REINIT_WARN("STEP4 ErrorCode=0x%08x 清零", (unsigned)hlcdc->ErrorCode);
+      hlcdc->ErrorCode = HAL_LCDC_ERROR_NONE;
+    }
+
+  /* STEP5：板级上电（幂等）：等 500us → LCD/QSPI 那几根脚重新 pinmux →
+   * PA10(LCD 供电使能)=1、PA37(VADD_EN)=1。PA00 是面板 RESET，STEP6 自己拉。 */
+  BSP_LCD_PowerUp();
+  LCD_REINIT_PASS("STEP5 BSP_LCD_PowerUp 完成（PA10 供电、PA37 VADD_EN=1、QSPI 脚 pinmux）");
+
+  /* STEP6：RESET 脚时序。开机只拉低 10ms（co5300.c 的 LCD_Drv_Init），这里给 30ms：
+   * 面板"丢配置"最常见的形状就是复位不彻底。之后 Init() 自己还会按 10ms 再拉
+   * 一轮，无害。 */
+  BSP_LCD_Reset(1);
+  up_mdelay(10);
+  BSP_LCD_Reset(0);
+  up_mdelay(SF32LB_LCD_RESET_LOW_MS);
+  BSP_LCD_Reset(1);
+  up_mdelay(SF32LB_LCD_RESET_HIGH_MS);
+  LCD_REINIT_PASS("STEP6 RESET 脚: 1→10ms→0→%dms→1→%dms（开机只拉低 10ms）",
+                  SF32LB_LCD_RESET_LOW_MS, SF32LB_LCD_RESET_HIGH_MS);
+
+  /* STEP7：面板 Init —— 内部第一步就是 HAL_LCDC_Init() → LCDC_HW_Init()：
+   * RCC_MOD_LCDC1 使能 + 硬复位 → SelectIntf → SetFreq（写 SPI_IF_CONF.CLK_DIV）
+   * → SetOutFormat → SetupTE → EnableInf → 释放 RSTB。这就是"显示通路重初始化"
+   * 的 SoC 侧那一步，之后才是面板那一串寄存器。 */
+  s_content_lost = true;   /* SWRESET 清 GRAM：通知上层整屏判脏（take_content_lost） */
+  p_drv_ops->p_ops->Init(hlcdc);
+  LCD_REINIT_STEP("STEP7 面板 Init 完成（含 HAL_LCDC_Init: RCC_MOD_LCDC1 复位→接口/分频/格式/TE）");
+
+  clk_div = (regs->SPI_IF_CONF & LCD_IF_SPI_IF_CONF_CLK_DIV_Msk)
+            >> LCD_IF_SPI_IF_CONF_CLK_DIV_Pos;
+  if (clk_div == 0u)
+    {
+      LCD_REINIT_WARN("STEP7 SPI_IF_CONF.CLK_DIV=0（硬件不支持分频 1）⇒ 时钟没配好");
+    }
+  else
+    {
+      LCD_REINIT_PASS("STEP7 SPI_IF_CONF.CLK_DIV=%u ⇒ 面板时钟≈%uMHz",
