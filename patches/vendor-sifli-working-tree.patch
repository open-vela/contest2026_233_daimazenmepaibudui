+  if ((regs->LCD_IF_CONF & LCD_IF_LCD_IF_CONF_LCD_RSTB) == 0u)
+    {
+      LCD_REINIT_WARN("STEP7 LCDC 的 LCD_RSTB 位没起来（LCD_IF_CONF=0x%08x）",
+                      (unsigned)regs->LCD_IF_CONF);
+    }
+
+  /* STEP8：补开机那一步中断接线（幂等）。LCDC1 的中断没接/没使能时，
+   * HAL_LCDC_SendLayerData2Reg_IT 永远等不到完成，State 会卡在 BUSY。 */
+#ifdef SOC_BF0_HCPU     /* gpio1 only work on hcpu */
+  irq_attach(NX_IRQ(LCDC1_IRQn), lcdc1_isr, (void *)hlcdc);
