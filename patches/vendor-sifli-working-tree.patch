+  SF32LB_LCD_PANEL_UNLOCK();
+
+  t_done = sf32lb_lcd_now_ms();
+  LCD_REINIT_STEP("===== 结束: 总耗时 %u ms，其中持锁 %u ms（这段时间刷屏被挡） =====",
+                  (unsigned)(t_done - t_enter), (unsigned)(t_done - t_locked));
