+    {
+      LCD_REINIT_PASS("STEP11 重发配置后读回面板 ID=0x%08x", (unsigned)id_after);
+      if (id_before == p_drv_ops->id)
+        {
+          LCD_REINIT_STEP("STEP12 结论: 动手前/后 ID 都读得回 ⇒ 面板通路本来就是通的，"
