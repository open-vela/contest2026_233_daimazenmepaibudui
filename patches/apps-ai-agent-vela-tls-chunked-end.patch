diff --git a/src/infra/vela_tls.c b/src/infra/vela_tls.c
index 0b36760..8fe9f00 100644
--- a/src/infra/vela_tls.c
+++ b/src/infra/vela_tls.c
@@ -524,6 +524,37 @@ static void tls_raw_release(char* buf)
     }
 }
 
+/**
+ * Has a chunked-transfer body finished arriving?
+ *
+ * The terminating chunk is a zero-length one, so the body ends with
+ * "0\r\n\r\n" (with trailers it is "0\r\n<trailer>\r\n\r\n"; scanning the
+ * last few bytes only recognizes the no-trailer form, which is what these
+ * servers send).
+ *
+ * Why this is needed: requests carry "Connection: keep-alive" and the
+ * read loop has no Content-Length to stop at when the response is chunked.
+ * Without this check the loop keeps calling mbedtls_ssl_read()/read() on a
+ * live connection waiting for data that will never come, and only returns
+ * when the socket's SO_RCVTIMEO expires -- AGENT_LLM_SOCKET_TIMEOUT_SEC,
+ * i.e. 120 seconds. On the board that looked exactly like "TTS request sent,
+ * then no log at all for two minutes".
+ */
+static int chunked_body_complete(const char* buf, size_t len)
+{
+    size_t i;
+
+    if (len < 5)
+        return 0;
+
+    for (i = (len > 8 ? len - 8 : 0); i + 5 <= len; i++) {
+        if (memcmp(buf + i, "0\r\n\r\n", 5) == 0)
+            return 1;
+    }
+
+    return 0;
+}
+
 static int tls_read_response(tls_ctx_t* ctx, char* resp_buf, size_t resp_cap,
     size_t* out_body_len, bool* out_keep_alive)
 {
@@ -618,6 +649,11 @@ static int tls_read_response(tls_ctx_t* ctx, char* resp_buf, size_t resp_cap,
                 resp_cap - 1 - resp_pos);
             if (ret > 0) {
                 resp_pos += (size_t)ret;
+
+                /* Terminating chunk seen: the body is complete, stop here
+                 * instead of waiting out the socket timeout. */
+                if (chunked && chunked_body_complete(resp_buf, resp_pos))
+                    break;
             } else if (ret == 0 || ret == MBEDTLS_ERR_SSL_PEER_CLOSE_NOTIFY) {
                 break;
             } else if (ret != MBEDTLS_ERR_SSL_WANT_READ) {
@@ -984,6 +1020,10 @@ int vela_http_post_json(const char* host, const char* port, const char* path,
             if (n <= 0)
                 break;
             resp_pos += (size_t)n;
+
+            /* Terminating chunk seen: same guard as the TLS path. */
+            if (chunked && chunked_body_complete(resp_buf, resp_pos))
+                break;
         }
     }
     resp_buf[resp_pos] = '\0';
